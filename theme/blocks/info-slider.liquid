<div class="tb vis-{{ block.settings.visibility }} tb-info" data-slides="{{ block.settings.speed | times: 1000 }}" {{ block.shopify_attributes }}>
  {%- assign first = true -%}
  {%- for i in (1..4) -%}
    {%- liquid
      assign tk = 'text_' | append: i
      assign ik = 'icon_' | append: i
    -%}
    {%- if block.settings[tk] != blank -%}<p class="announcement__slide tb-info__item{% if first %} is-active{% endif %}">{% render 'icon', name: block.settings[ik], size: 18 %} {{ block.settings[tk] }}</p>{%- assign first = false -%}{%- endif -%}
  {%- endfor -%}
</div>

