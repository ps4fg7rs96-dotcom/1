{%- assign dlg = 'BlockPopup-' | append: block.id -%}
<div class="tb vis-{{ block.settings.visibility }} tb-popup" {{ block.shopify_attributes }}>
  <button type="button" class="{% if block.settings.style == 'link' %}link{% else %}btn btn--{{ block.settings.style }}{% endif %}" data-dialog-open="{{ dlg }}">{%- if block.settings.icon != 'none' -%}{% render 'icon', name: block.settings.icon, size: 18 %}{%- endif -%} {{ block.settings.label }}</button>
  <dialog id="{{ dlg }}" class="modal" aria-labelledby="{{ dlg }}-t">
    <div class="modal__box">
      <button type="button" class="icon-btn modal__close" data-dialog-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
      <h2 id="{{ dlg }}-t" class="h3">{{ block.settings.heading | default: block.settings.label }}</h2>
      <div class="rte">{{ block.settings.content }}{%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}</div>
    </div>
  </dialog>
</div>

{% schema %}
{
  "name": "Pop-up au clic",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Libellé du bouton",
      "default": "En savoir plus"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "link",
          "label": "Lien"
        },
        {
          "value": "primary",
          "label": "Bouton principal"
        },
        {
          "value": "secondary",
          "label": "Bouton secondaire"
        }
      ],
      "default": "link"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icône",
      "options": [
        {
          "value": "none",
          "label": "Aucune"
        },
        {
          "value": "info",
          "label": "Info"
        },
        {
          "value": "ruler",
          "label": "Règle"
        },
        {
          "value": "truck",
          "label": "Livraison"
        },
        {
          "value": "gift",
          "label": "Cadeau"
        },
        {
          "value": "chat",
          "label": "Discussion"
        }
      ],
      "default": "info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre de la fenêtre"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Contenu",
      "default": "<p>Le contenu de votre fenêtre.</p>"
    },
    {
      "type": "page",
      "id": "page",
      "label": "Ou contenu d'une page"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Afficher sur",
      "options": [
        {
          "value": "all",
          "label": "Tous les écrans"
        },
        {
          "value": "mobile",
          "label": "Mobile uniquement"
        },
        {
          "value": "desktop",
          "label": "Ordinateur uniquement"
        }
      ],
      "default": "all"
    }
  ],
  "presets": [
    {
      "name": "Pop-up au clic"
    }
  ]
}
{% endschema %}
