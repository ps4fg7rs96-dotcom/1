<div class="tb vis-{{ block.settings.visibility }} tb-tabs" data-tabs {{ block.shopify_attributes }}>
  <div class="tabs-bar" role="tablist">
    {%- for i in (1..4) -%}{%- assign tk = 'title_' | append: i -%}{%- if block.settings[tk] != blank -%}<button type="button" role="tab" class="chip" id="T-{{ block.id }}-{{ i }}" aria-controls="P-{{ block.id }}-{{ i }}" aria-selected="{% if i == 1 %}true{% else %}false{% endif %}" tabindex="{% if i == 1 %}0{% else %}-1{% endif %}">{{ block.settings[tk] }}</button>{%- endif -%}{%- endfor -%}
  </div>
  {%- for i in (1..4) -%}
    {%- liquid
      assign tk = 'title_' | append: i
      assign ck = 'content_' | append: i
      assign pk = 'page_' | append: i
    -%}
    {%- if block.settings[tk] != blank -%}<div role="tabpanel" id="P-{{ block.id }}-{{ i }}" aria-labelledby="T-{{ block.id }}-{{ i }}" class="rte tb-tabs__panel"{% unless i == 1 %} hidden{% endunless %}>{{ block.settings[ck] }}{%- if block.settings[pk] != blank -%}{{ block.settings[pk].content }}{%- endif -%}</div>{%- endif -%}
  {%- endfor -%}
</div>

