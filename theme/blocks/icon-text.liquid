<div class="tb vis-{{ block.settings.visibility }} tb-icon-text tb-icon-text--{{ block.settings.layout }}" {{ block.shopify_attributes }}>
  <span class="icon-chip">{% render 'icon', name: block.settings.icon, size: 22 %}</span>
  <div>{%- if block.settings.title != blank -%}<p class="tb-icon-text__title">{{ block.settings.title }}</p>{%- endif -%}{%- if block.settings.text != blank -%}<div class="rte muted small">{{ block.settings.text }}</div>{%- endif -%}</div>
</div>

