<span class="tb vis-{{ block.settings.visibility }} tb-icon" style="--size: {{ block.settings.size }}px; color: {% if block.settings.color != blank %}{{ block.settings.color }}{% else %}var(--c-link){% endif %}; justify-self: {{ block.settings.align }}" {{ block.shopify_attributes }}>
  {%- if block.settings.chip -%}<span class="icon-chip">{% render 'icon', name: block.settings.icon, size: block.settings.size %}</span>{%- else -%}{% render 'icon', name: block.settings.icon, size: block.settings.size %}{%- endif -%}
</span>

