            "value": "minimal",
            "label": "Minimaliste — noir & blanc"
          },
          {
            "value": "luxe",
            "label": "Luxe — crème, noir & or"
          },
          {
            "value": "nature",
            "label": "Nature & bio — sauge & beige"
          },
          {
            "value": "bold",
            "label": "Audacieux — streetwear, majuscules"
          },
          {
            "value": "soft",
            "label": "Doux — beauté, rose poudré"
