{%- comment -%} Données des variantes pour assets/theme.js. Paramètre : product {%- endcomment -%}
<script type="application/json" data-product-json>
  {
    "variants": [
      {%- for v in product.variants limit: 250 -%}
        { "id": {{ v.id }}, "options": {{ v.options | json }}, "available": {{ v.available | json }}, "featured_media_id": {% if v.featured_media %}{{ v.featured_media.id }}{% else %}null{% endif %}, "sku": {{ v.sku | json }}, "inventory": {% if v.inventory_management == 'shopify' %}{{ v.inventory_quantity | default: 0 }}{% else %}null{% endif %} }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    "prices": {
      {%- for v in product.variants limit: 250 -%}
        {%- capture price_html -%}{% render 'price', product: product, variant: v %}{%- endcapture -%}
        "{{ v.id }}": {{ price_html | strip_newlines | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  }
</script>
