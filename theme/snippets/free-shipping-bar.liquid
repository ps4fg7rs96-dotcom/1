{%- comment -%} Jauge de livraison offerte. Seuil exprimé dans la devise principale (réglage du thème). {%- endcomment -%}
{%- if settings.show_free_shipping and settings.free_shipping_threshold > 0 -%}
  {%- liquid
    assign threshold_local = settings.free_shipping_threshold | times: 100.0
    assign remaining = threshold_local | minus: cart.total_price
    assign pct = cart.total_price | times: 100.0 | divided_by: threshold_local
    if pct > 100
      assign pct = 100
    endif
  -%}
  <div class="ship-bar{% if remaining <= 0 %} is-done{% endif %}">
    <p class="ship-bar__text">
      {%- render 'icon', name: 'truck', size: 18 -%}
      {%- if remaining > 0 -%}
        {%- assign remaining_money = remaining | money -%}
        {{ 'cart.free_shipping_remaining_html' | t: amount: remaining_money }}
      {%- else -%}
        {{ 'cart.free_shipping_done' | t }}
      {%- endif -%}
    </p>
    <div class="ship-bar__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct | round }}" aria-label="{{ 'cart.free_shipping_label' | t }}">
      <span class="ship-bar__fill" style="width: {{ pct | round: 1 }}%"></span>
    </div>
  </div>
{%- endif -%}
