{%- comment -%} Prix d'un produit ou d'une variante. Paramètres : product, variant (optionnel) {%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign compare = target.compare_at_price
  assign on_sale = false
  if compare > target.price
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--sale{% endif %}{% if target.available == false %} price--sold-out{% endif %}" data-price>
  {%- if product.price_varies and variant == nil -%}
    {%- assign min_price = product.price_min | money -%}
    <span class="price__current">{{ 'products.product.price_from' | t: price: min_price }}</span>
  {%- else -%}
    <span class="visually-hidden">{{ 'products.product.price' | t }}</span>
    <span class="price__current">{{ target.price | money }}</span>
    {%- if on_sale -%}
      <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
      <s class="price__compare">{{ compare | money }}</s>
    {%- endif -%}
  {%- endif -%}
  {%- if target.unit_price_measurement -%}
    <span class="price__unit">{{ target.unit_price | money }}/{{ target.unit_price_measurement.reference_unit }}</span>
  {%- endif -%}
</div>
