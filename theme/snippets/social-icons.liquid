{%- assign networks = 'instagram,tiktok,facebook,youtube,pinterest,linkedin' | split: ',' -%}
<ul class="social" role="list">
  {%- for n in networks -%}
    {%- assign key = 'social_' | append: n -%}
    {%- if settings[key] != blank -%}
      <li><a href="{{ settings[key] }}" class="icon-btn" target="_blank" rel="noopener" aria-label="{{ n | capitalize }}">{% render 'icon', name: n %}</a></li>
    {%- endif -%}
  {%- endfor -%}
</ul>
