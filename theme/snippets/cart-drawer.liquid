{%- comment -%}
  Tiroir panier. Re-rendu via l'API Section Rendering (section « cart-drawer »).
{%- endcomment -%}
<div class="drawer" id="CartDrawer" data-cart-drawer hidden>
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1">
    <div class="drawer__inner" data-cart-drawer-inner>
      <header class="drawer__head">
        <h2 class="drawer__title" id="CartDrawerTitle">{{ 'cart.title' | t }} <span class="drawer__count">({{ cart.item_count }})</span></h2>
        <button type="button" class="icon-btn" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
      </header>

      {% render 'free-shipping-bar' %}

      {%- if cart.item_count > 0 -%}
        <ul class="cart-lines" role="list">
          {%- for item in cart.items -%}
            <li class="cart-line" data-line="{{ forloop.index }}">
              <a href="{{ item.url }}" class="cart-line__media" tabindex="-1" aria-hidden="true">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', width: 80, height: 80, alt: '' }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>
              <div class="cart-line__info">
                <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-line__variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                {%- for discount in item.line_level_discount_allocations -%}
                  <p class="cart-line__discount">{% render 'icon', name: 'tag', size: 14 %} {{ discount.discount_application.title }}</p>
                {%- endfor -%}
                <div class="qty qty--sm">
                  <button type="button" class="qty__btn" data-qty-change="{{ item.quantity | minus: 1 }}" data-line="{{ forloop.index }}" aria-label="{{ 'cart.decrease' | t: title: item.product.title | escape }}">{% render 'icon', name: 'minus', size: 14 %}</button>
                  <span class="qty__value" aria-live="polite">{{ item.quantity }}</span>
                  <button type="button" class="qty__btn" data-qty-change="{{ item.quantity | plus: 1 }}" data-line="{{ forloop.index }}" aria-label="{{ 'cart.increase' | t: title: item.product.title | escape }}">{% render 'icon', name: 'plus', size: 14 %}</button>
                </div>
              </div>
              <div class="cart-line__end">
                <p class="cart-line__price">{{ item.final_line_price | money }}</p>
                <button type="button" class="link link--muted" data-qty-change="0" data-line="{{ forloop.index }}">{{ 'cart.remove' | t }}</button>
              </div>
            </li>
          {%- endfor -%}
        </ul>
        <footer class="drawer__foot">
          {%- for discount in cart.cart_level_discount_applications -%}
            <p class="cart-total cart-total--discount"><span>{{ discount.title }}</span><span>−{{ discount.total_allocated_amount | money }}</span></p>
          {%- endfor -%}
          <p class="cart-total"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money_with_currency }}</span></p>
          <p class="cart-note-small">{{ 'cart.taxes_note' | t }}</p>
          <form action="{{ routes.cart_url }}" method="post" class="drawer__checkout">
            <button type="submit" name="checkout" class="btn btn--primary btn--lg btn--block">{{ 'cart.checkout' | t }} {% render 'icon', name: 'arrow-right', size: 18 %}</button>
          </form>
          <a href="{{ routes.cart_url }}" class="link drawer__view-cart">{{ 'cart.view_cart' | t }}</a>
          {%- if settings.cart_reassurance != blank -%}
            <p class="cart-reassurance">{% render 'icon', name: 'shield', size: 16 %} {{ settings.cart_reassurance }}</p>
          {%- endif -%}
        </footer>
      {%- else -%}
        <div class="drawer__empty">
          <span class="empty-icon">{% render 'icon', name: 'cart', size: 32 %}</span>
          <p>{{ 'cart.empty' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ 'cart.continue' | t }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
