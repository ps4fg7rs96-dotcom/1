{%- assign apps = section.blocks | where: 'type', 'app' -%}
<section class="section section--alt" aria-labelledby="Compare-{{ section.id }}">
  <div class="page-width">
    {%- assign hid = 'Compare-' | append: section.id -%}
    {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, lead: section.settings.lead, id: hid %}
    <div class="compare">
      <div class="compare__col compare__col--before" data-reveal>
        <h3 class="compare__title"><span class="compare__x">{% render 'icon', name: 'close', size: 18 %}</span>{{ section.settings.before_title }}</h3>
        <ul class="compare__rows" role="list">
          {%- for block in apps -%}
            <li {{ block.shopify_attributes }}>
              <span class="compare__label">{% render 'icon', name: 'puzzle', size: 16 %}{{ block.settings.label }}</span>
              <span class="compare__cost"><span class="ph" title="{{ 'general.placeholder' | t }}">{{ block.settings.price }}</span><small class="muted">{{ section.settings.per_month }}</small></span>
            </li>
          {%- endfor -%}
        </ul>
        <p class="compare__total"><span>{{ section.settings.total_label }}</span><strong><span class="ph" title="{{ 'general.placeholder' | t }}">{{ section.settings.total }}</span><small>{{ section.settings.per_month }}</small></strong></p>
        {%- assign cons = section.settings.cons | newline_to_br | split: '<br />' -%}
        <ul class="compare__cons" role="list">
          {%- for c in cons -%}{%- assign line = c | strip -%}{%- if line != blank -%}<li>{{ line }}</li>{%- endif -%}{%- endfor -%}
        </ul>
      </div>
      <div class="compare__col compare__col--after" data-reveal style="--d: 120ms">
        <h3 class="compare__title">
          <svg width="36" height="36" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="13.5" fill="#fff" fill-opacity=".15"/><rect x="19.6" y="14.9" width="8.4" height="34.9" rx="1.6" fill="#F1EFEA"/><path d="M28 27.8 42.4 14.9h9.7L35.7 32.3l16.4 17.5h-9.7L28 36.8z" fill="#F1EFEA"/><g fill="#EC7454"><rect x="6.7" y="23" width="8.9" height="3.8" rx="1.9"/><rect x="4.2" y="30.4" width="11.4" height="3.8" rx="1.9"/><rect x="6.7" y="37.8" width="8.9" height="3.8" rx="1.9"/></g></svg>
          {{ section.settings.after_title }}
        </h3>
        {%- assign pros = section.settings.pros | newline_to_br | split: '<br />' -%}
        <ul class="check-list" role="list">
          {%- for p in pros -%}{%- assign line = p | strip -%}{%- if line != blank -%}<li><span class="check-dot">{% render 'icon', name: 'check' %}</span>{{ line }}</li>{%- endif -%}{%- endfor -%}
        </ul>
        <p class="compare__price"><span>{{ section.settings.price_label }}</span><strong>{{ section.settings.price }}<small>{{ section.settings.per_month }}</small></strong></p>
        {%- if section.settings.cta_label != blank -%}
          <div class="btn-wrap"><a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="btn btn--inverse btn--lg">{{ section.settings.cta_label }} {% render 'icon', name: 'arrow-right', size: 18 %}</a></div>
        {%- endif -%}
      </div>
    </div>
    {%- if section.settings.note != blank -%}<p class="compare__note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Comparatif apps vs natif",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Avant / avec Kinetic" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Arrêtez d'empiler les abonnements" },
    { "type": "textarea", "id": "lead", "label": "Introduction" },
    { "type": "header", "content": "Colonne « avant »" },
    { "type": "text", "id": "before_title", "label": "Titre", "default": "Thème classique + applications" },
    { "type": "text", "id": "total_label", "label": "Libellé du total", "default": "Total mensuel" },
    { "type": "text", "id": "total", "label": "Total", "default": "[122 €]" },
    { "type": "textarea", "id": "cons", "label": "Inconvénients (un par ligne)", "default": "Scripts tiers qui ralentissent chaque page\nStyles incohérents d'une appli à l'autre" },
    { "type": "header", "content": "Colonne « avec Kinetic »" },
    { "type": "text", "id": "after_title", "label": "Titre", "default": "Avec Kinetic" },
    { "type": "textarea", "id": "pros", "label": "Avantages (un par ligne)", "default": "Avis, upsells et offres groupées intégrés\nUn seul abonnement" },
    { "type": "text", "id": "price_label", "label": "Libellé du prix", "default": "À partir de" },
    { "type": "text", "id": "price", "label": "Prix", "default": "31 €" },
    { "type": "text", "id": "per_month", "label": "Suffixe mensuel", "default": "/mois" },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Démarrer l'essai gratuit" },
    { "type": "url", "id": "cta_link", "label": "Lien du bouton" },
    { "type": "text", "id": "note", "label": "Note", "default": "[Montants indicatifs à remplacer par vos estimations]" }
  ],
  "blocks": [
    {
      "type": "app",
      "name": "Application payante",
      "settings": [
        { "type": "text", "id": "label", "label": "Fonction", "default": "Application d'avis clients" },
        { "type": "text", "id": "price", "label": "Coût mensuel", "default": "[15 €]" }
      ]
    }
  ],
  "presets": [{ "name": "Comparatif apps vs natif", "blocks": [{ "type": "app" }, { "type": "app" }, { "type": "app" }] }]
}
{% endschema %}
