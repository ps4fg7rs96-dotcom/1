{%- comment -%} NEWSLETTER — inscription (clients Shopify, tag « newsletter »), avec code de bienvenue optionnel. {%- endcomment -%}
{{ 'sections.css' | asset_url | stylesheet_tag }}
<section class="section scheme-{{ section.settings.color_scheme }} pad-{{ section.settings.padding }}">
  <div class="page-width">
    <div class="newsletter newsletter--{{ section.settings.layout }}{% if section.settings.boxed %} newsletter--boxed{% endif %}">
      {%- if section.settings.image != blank -%}<div class="newsletter__media">{{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 700, 1000', sizes: '(min-width: 990px) 40vw, 100vw', alt: section.settings.image.alt }}</div>{%- endif -%}
      <div class="newsletter__content">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="lead">{{ section.settings.text }}</div>{%- endif -%}
        {%- assign nl_id = 'Newsletter-' | append: section.id -%}
        {%- form 'customer', id: nl_id, class: 'newsletter__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success" tabindex="-1" autofocus>{{ section.settings.success }}</p>
            {%- if section.settings.discount_code != blank -%}
              <button type="button" class="discount-code" data-copy="{{ section.settings.discount_code | escape }}">{{ section.settings.discount_code }} <span class="small">{% render 'icon', name: 'copy', size: 16 %} {{ 'features.copy' | t }}</span></button>
            {%- endif -%}
          {%- else -%}
            {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
            <div class="inline-form">
              <label for="NlEmail-{{ section.id }}" class="visually-hidden">{{ 'general.email' | t }}</label>
              <input id="NlEmail-{{ section.id }}" class="input" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'general.email' | t }}">
              <button type="submit" class="btn btn--primary">{{ section.settings.button }}</button>
            </div>
            {%- if section.settings.legal != blank -%}<p class="small muted newsletter__legal">{{ section.settings.legal }}</p>{%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "layout", "label": "Disposition", "options": [{ "value": "center", "label": "Centrée" }, { "value": "split", "label": "Image + formulaire" }], "default": "center" },
    { "type": "checkbox", "id": "boxed", "label": "Dans une carte", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Newsletter" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "−10 % sur votre première commande" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Nouveautés, conseils et offres réservées aux abonnés. Un e-mail par mois, pas plus.</p>" },
    { "type": "text", "id": "button", "label": "Bouton", "default": "Je m'inscris" },
    { "type": "text", "id": "success", "label": "Message de confirmation", "default": "Bienvenue ! Voici votre code :" },
    { "type": "text", "id": "discount_code", "label": "Code de bienvenue (facultatif)", "info": "Créez le code dans Shopify › Réductions." },
    { "type": "text", "id": "legal", "label": "Mention légale", "default": "Désinscription en un clic à tout moment." },
    {"type": "header", "content": "Mise en forme de la section"},
    {"type": "select", "id": "color_scheme", "label": "Palette de couleurs", "options": [{"value": "theme", "label": "Thème"}, {"value": "alt", "label": "Alternée"}, {"value": "tint", "label": "Teintée"}, {"value": "dark", "label": "Sombre"}, {"value": "primary", "label": "Couleur primaire"}, {"value": "accent", "label": "Couleur d'accent"}, {"value": "custom-1", "label": "Personnalisée 1"}, {"value": "custom-2", "label": "Personnalisée 2"}], "default": "theme"},
    {"type": "select", "id": "padding", "label": "Espacement vertical", "options": [{"value": "none", "label": "Aucun"}, {"value": "s", "label": "Petit"}, {"value": "m", "label": "Moyen"}, {"value": "l", "label": "Grand"}, {"value": "xl", "label": "Très grand"}], "default": "l"}
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
