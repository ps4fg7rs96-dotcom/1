{%- paginate search.results by 16 -%}
  <section class="section section--tight">
    <div class="page-width">
      <div class="section-head" style="margin-bottom: 2rem;">
        <h1 class="h1">{{ 'search.title' | t }}</h1>
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
          <label for="SearchPage" class="visually-hidden">{{ 'search.title' | t }}</label>
          <input id="SearchPage" class="input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'sections.header.search_placeholder' | t }}">
          <button type="submit" class="btn btn--primary">{% render 'icon', name: 'search', size: 18 %}<span class="visually-hidden">{{ 'search.submit' | t }}</span></button>
        </form>
        {%- if search.performed -%}<p class="muted" style="margin-top: 1rem;" role="status">{{ 'search.results_count' | t: count: search.results_count, terms: search.terms }}</p>{%- endif -%}
      </div>

      {%- if search.performed -%}
        {%- if search.results_count > 0 -%}
          {%- assign products = search.results | where: 'object_type', 'product' -%}
          {%- assign others = search.results | where: 'object_type', 'article' -%}
          {%- assign pages = search.results | where: 'object_type', 'page' -%}
          {%- if products.size > 0 -%}
            <ul class="product-grid product-grid--4" role="list">
              {%- for item in products -%}<li>{% render 'product-card', product: item %}</li>{%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if others.size > 0 or pages.size > 0 -%}
            <ul class="search-results" role="list" style="margin-top: 2.5rem;">
              {%- for item in others -%}<li><a class="search-result" href="{{ item.url }}">{% render 'icon', name: 'image', size: 20 %}<span>{{ item.title }}</span></a></li>{%- endfor -%}
              {%- for item in pages -%}<li><a class="search-result" href="{{ item.url }}">{% render 'icon', name: 'layers', size: 20 %}<span>{{ item.title }}</span></a></li>{%- endfor -%}
            </ul>
          {%- endif -%}
          {% render 'pagination', paginate: paginate %}
        {%- else -%}
          <div class="empty-state"><span class="empty-icon">{% render 'icon', name: 'search', size: 28 %}</span><p>{{ 'search.no_results' | t: terms: search.terms }}</p></div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{ "name": "Résultats de recherche", "settings": [] }
{% endschema %}
