{%- comment -%} AVANT / APRÈS — curseur glissant entre deux images (clavier : flèches). {%- endcomment -%}
{{ 'sections.css' | asset_url | stylesheet_tag }}
<section class="section scheme-{{ section.settings.color_scheme }} pad-{{ section.settings.padding }}">
  <div class="page-width ba-wrap ba-wrap--{{ section.settings.layout }}">
    <div class="ba__text">
      {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, lead: section.settings.text, align: 'left' %}
    </div>
    <div class="ba" data-before-after style="--pos: {{ section.settings.start }}%; --ratio: {{ section.settings.ratio }}">
      <div class="ba__img ba__img--after">
        {%- if section.settings.after != blank -%}{{ section.settings.after | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '500, 800, 1200, 1600', sizes: '(min-width: 990px) 55vw, 100vw', alt: section.settings.after.alt }}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
        <span class="ba__tag ba__tag--after">{{ section.settings.after_label }}</span>
      </div>
      <div class="ba__img ba__img--before">
        {%- if section.settings.before != blank -%}{{ section.settings.before | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '500, 800, 1200, 1600', sizes: '(min-width: 990px) 55vw, 100vw', alt: section.settings.before.alt }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
        <span class="ba__tag">{{ section.settings.before_label }}</span>
      </div>
      <span class="ba__handle" aria-hidden="true">{% render 'icon', name: 'chevron-left', size: 16 %}{% render 'icon', name: 'chevron-right', size: 16 %}</span>
      <label class="visually-hidden" for="Ba-{{ section.id }}">{{ 'sections.before_after.label' | t }}</label>
      <input id="Ba-{{ section.id }}" class="ba__range" type="range" min="0" max="100" value="{{ section.settings.start }}">
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Avant / après",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Résultat" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "La différence, en un geste" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Faites glisser le curseur pour comparer.</p>" },
    { "type": "image_picker", "id": "before", "label": "Image « avant »" },
    { "type": "text", "id": "before_label", "label": "Étiquette avant", "default": "Avant" },
    { "type": "image_picker", "id": "after", "label": "Image « après »" },
    { "type": "text", "id": "after_label", "label": "Étiquette après", "default": "Après" },
    { "type": "range", "id": "start", "min": 10, "max": 90, "step": 5, "unit": "%", "label": "Position de départ", "default": 50 },
    { "type": "select", "id": "ratio", "label": "Format", "options": [{ "value": "4 / 3", "label": "Paysage" }, { "value": "1 / 1", "label": "Carré" }, { "value": "16 / 9", "label": "Panoramique" }, { "value": "3 / 4", "label": "Portrait" }], "default": "4 / 3" },
    { "type": "select", "id": "layout", "label": "Disposition", "options": [{ "value": "side", "label": "Texte à côté" }, { "value": "stacked", "label": "Texte au-dessus" }], "default": "side" },
    {"type": "header", "content": "Mise en forme de la section"},
    {"type": "select", "id": "color_scheme", "label": "Palette de couleurs", "options": [{"value": "theme", "label": "Thème"}, {"value": "alt", "label": "Alternée"}, {"value": "tint", "label": "Teintée"}, {"value": "dark", "label": "Sombre"}, {"value": "primary", "label": "Couleur primaire"}, {"value": "accent", "label": "Couleur d'accent"}, {"value": "custom-1", "label": "Personnalisée 1"}, {"value": "custom-2", "label": "Personnalisée 2"}], "default": "theme"},
    {"type": "select", "id": "padding", "label": "Espacement vertical", "options": [{"value": "none", "label": "Aucun"}, {"value": "s", "label": "Petit"}, {"value": "m", "label": "Moyen"}, {"value": "l", "label": "Grand"}, {"value": "xl", "label": "Très grand"}], "default": "l"}
  ],
  "presets": [{ "name": "Avant / après" }]
}
{% endschema %}
