{%- comment -%}
  FONCTIONNALITÉS — catalogue illustré de tout ce que fait le thème : aperçu, description,
  économie estimée, type (bloc / section / réglage) et catégorie. Filtres par catégorie + recherche.
{%- endcomment -%}
{{ 'section-features.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign features = section.blocks | where: 'type', 'feature'
  assign total_savings = 0
  for b in features
    assign total_savings = total_savings | plus: b.settings.savings
  endfor
  assign cats = 'conversion,cart,navigation,trust,content,design' | split: ','
  assign card_tag = 'h3'
  if section.settings.heading_h1
    assign card_tag = 'h2'
  endif
-%}
<section class="section scheme-{{ section.settings.color_scheme }} pad-{{ section.settings.padding }} features" data-features>
  <div class="page-width">
    <div class="features__head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading_h1 -%}<h1 class="h1">{{ section.settings.heading }}</h1>{%- else -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.lead != blank -%}<div class="lead">{{ section.settings.lead }}</div>{%- endif -%}
      {%- if section.settings.show_summary -%}
        <ul class="features__summary" role="list">
          <li><b>{{ features.size }}</b><span>{{ 'features.catalog.count' | t }}</span></li>
          <li><b class="ph" title="{{ 'general.placeholder' | t }}">≈ {{ total_savings }} €</b><span>{{ 'features.catalog.per_month' | t }}</span></li>
          <li><b>0</b><span>{{ 'features.catalog.no_app' | t }}</span></li>
        </ul>
      {%- endif -%}
    </div>

    {%- if section.settings.show_filters -%}
      <div class="features__tools">
        <div class="features__filters" role="group" aria-label="{{ 'features.catalog.filter' | t }}">
          <button type="button" class="chip is-active" data-fcat="all" aria-pressed="true">{{ 'features.catalog.all' | t }} <span>{{ features.size }}</span></button>
          {%- for c in cats -%}
            {%- assign count = 0 -%}
            {%- for b in features -%}{%- if b.settings.category == c -%}{%- assign count = count | plus: 1 -%}{%- endif -%}{%- endfor -%}
            {%- if count > 0 -%}
              {%- assign ck = 'features.catalog.cat.' | append: c -%}
              <button type="button" class="chip" data-fcat="{{ c }}" aria-pressed="false">{{ ck | t }} <span>{{ count }}</span></button>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <label class="features__search">
          {% render 'icon', name: 'search', size: 18 %}
          <span class="visually-hidden">{{ 'features.catalog.search' | t }}</span>
          <input class="input" type="search" placeholder="{{ 'features.catalog.search' | t }}" data-fsearch>
        </label>
      </div>
    {%- endif -%}

    <ul class="features__grid features__grid--{{ section.settings.columns }}" role="list">
      {%- for block in features -%}
        {%- liquid
          assign kk = 'features.catalog.kind.' | append: block.settings.kind
          assign ck = 'features.catalog.cat.' | append: block.settings.category
        -%}
        <li class="fcard" data-fcard data-cat="{{ block.settings.category }}" data-q="{{ block.settings.title | append: ' ' | append: block.settings.text | downcase | escape }}" {{ block.shopify_attributes }}>
          <div class="fcard__preview">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 700, 1000', sizes: '(min-width: 990px) 45vw, 92vw', class: 'fcard__img', alt: block.settings.title }}
            {%- else -%}
              {% render 'feature-preview', key: block.settings.preview %}
            {%- endif -%}
          </div>
          <div class="fcard__body">
            <{{ card_tag }} class="fcard__title h3">{{ block.settings.title }}</{{ card_tag }}>
            <p class="fcard__text">{{ block.settings.text }}</p>
            <ul class="fcard__chips" role="list">
              <li class="fchip fchip--save">{% render 'icon', name: 'sparkle', size: 16 %}
                {%- if block.settings.savings > 0 -%}<span class="ph" title="{{ 'general.placeholder' | t }}">{{ 'features.catalog.save' | t: amount: block.settings.savings }}</span>{%- else -%}{{ 'features.catalog.included' | t }}{%- endif -%}
              </li>
              <li class="fchip">{{ kk | t }}</li>
              <li class="fchip">{{ ck | t }}</li>
            </ul>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="link fcard__link">{{ 'features.catalog.see' | t }} {% render 'icon', name: 'arrow-right', size: 16 %}</a>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
    <p class="features__empty muted" data-fempty hidden>{{ 'features.catalog.empty' | t }}</p>
    {%- if section.settings.savings_note != blank -%}<p class="small muted features__note">{{ section.settings.savings_note }}</p>{%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div class="features__cta card">
        <span class="hero-lines" aria-hidden="true"><i></i><i></i><i></i></span>
        <p class="h3">{{ section.settings.cta_heading }}</p>
        <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="btn btn--primary btn--lg">{{ section.settings.cta_label }} {% render 'icon', name: 'arrow-right', size: 18 %}</a>
      </div>
    {%- endif -%}
  </div>
  <script>
    (function () {
      var root = document.currentScript.closest('[data-features]');
      var cards = Array.prototype.slice.call(root.querySelectorAll('[data-fcard]'));
      var input = root.querySelector('[data-fsearch]');
      var empty = root.querySelector('[data-fempty]');
      var cat = 'all';
      function apply() {
        var q = input ? input.value.trim().toLowerCase() : '', n = 0;
        cards.forEach(function (c) { var ok = (cat === 'all' || c.dataset.cat === cat) && (!q || c.dataset.q.indexOf(q) > -1); c.hidden = !ok; if (ok) n++; });
        if (empty) empty.hidden = n > 0;
      }
      root.addEventListener('click', function (e) {
        var b = e.target.closest('[data-fcat]');
        if (!b) return;
        cat = b.dataset.fcat;
        root.querySelectorAll('[data-fcat]').forEach(function (x) { var on = x === b; x.classList.toggle('is-active', on); x.setAttribute('aria-pressed', String(on)); });
        apply();
      });
      if (input) input.addEventListener('input', apply);
    })();
  </script>
</section>

