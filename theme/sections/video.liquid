{%- comment -%}
  VIDÉO — vidéo Shopify (lecture auto en boucle possible) ou YouTube / Vimeo chargés au clic
  (aucun script tiers avant l'interaction). Option « vidéo achetable » : produit lié sous la vidéo.
{%- endcomment -%}
{{ 'sections.css' | asset_url | stylesheet_tag }}
<section class="section scheme-{{ section.settings.color_scheme }} pad-{{ section.settings.padding }}">
  <div class="{% if section.settings.full_width %}video-full{% else %}page-width{% endif %}">
    {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, lead: section.settings.text %}
    <div class="video-box" style="--ratio: {{ section.settings.ratio }}">
      {%- if section.settings.video != blank -%}
        {%- if section.settings.autoplay -%}
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'video-box__media', image_size: '1600x' }}
        {%- else -%}
          {{ section.settings.video | video_tag: controls: true, playsinline: true, preload: 'none', class: 'video-box__media', image_size: '1600x' }}
        {%- endif -%}
      {%- elsif section.settings.video_url != blank -%}
        <button type="button" class="video-box__facade" data-video-facade data-provider="{{ section.settings.video_url.type }}" data-video-id="{{ section.settings.video_url.id }}" aria-label="{{ 'sections.video.play' | t: title: section.settings.heading | escape }}">
          {%- if section.settings.cover != blank -%}
            {{ section.settings.cover | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1800', sizes: '100vw', class: 'video-box__media', alt: '' }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg video-box__media' }}
          {%- endif -%}
          <span class="video-box__play">{% render 'icon', name: 'play', size: 26 %}</span>
        </button>
      {%- else -%}
        <div class="video-box__facade">{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg video-box__media' }}<span class="video-box__play">{% render 'icon', name: 'play', size: 26 %}</span></div>
      {%- endif -%}
    </div>
    {%- assign p = section.settings.product -%}
    {%- if p != blank -%}
      <div class="video-product page-width">
        <a href="{{ p.url }}" class="video-product__img">{%- if p.featured_media -%}{{ p.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', alt: p.title }}{%- endif -%}</a>
        <div class="video-product__info"><a href="{{ p.url }}" class="video-product__title">{{ p.title }}</a>{% render 'price', product: p %}</div>
        <button type="button" class="btn btn--primary btn--sm" data-quick-view="{{ p.url }}">{{ 'features.shop_now' | t }}</button>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Vidéo",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Le produit en mouvement" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "video", "id": "video", "label": "Vidéo hébergée sur Shopify" },
    { "type": "checkbox", "id": "autoplay", "label": "Lecture automatique, muette, en boucle", "default": false },
    { "type": "video_url", "id": "video_url", "accept": ["youtube", "vimeo"], "label": "Ou lien YouTube / Vimeo", "info": "Chargé seulement au clic : la page reste rapide." },
    { "type": "image_picker", "id": "cover", "label": "Image de couverture (YouTube / Vimeo)" },
    { "type": "select", "id": "ratio", "label": "Format", "options": [{ "value": "16 / 9", "label": "16:9" }, { "value": "4 / 3", "label": "4:3" }, { "value": "1 / 1", "label": "Carré" }, { "value": "9 / 16", "label": "Vertical (9:16)" }, { "value": "21 / 9", "label": "Cinéma (21:9)" }], "default": "16 / 9" },
    { "type": "checkbox", "id": "full_width", "label": "Pleine largeur", "default": false },
    { "type": "product", "id": "product", "label": "Produit à acheter (vidéo achetable)" },
    {"type": "header", "content": "Mise en forme de la section"},
    {"type": "select", "id": "color_scheme", "label": "Palette de couleurs", "options": [{"value": "theme", "label": "Thème"}, {"value": "alt", "label": "Alternée"}, {"value": "tint", "label": "Teintée"}, {"value": "dark", "label": "Sombre"}, {"value": "primary", "label": "Couleur primaire"}, {"value": "accent", "label": "Couleur d'accent"}, {"value": "custom-1", "label": "Personnalisée 1"}, {"value": "custom-2", "label": "Personnalisée 2"}], "default": "theme"},
    {"type": "select", "id": "padding", "label": "Espacement vertical", "options": [{"value": "none", "label": "Aucun"}, {"value": "s", "label": "Petit"}, {"value": "m", "label": "Moyen"}, {"value": "l", "label": "Grand"}, {"value": "xl", "label": "Très grand"}], "default": "l"}
  ],
  "presets": [{ "name": "Vidéo" }]
}
{% endschema %}
