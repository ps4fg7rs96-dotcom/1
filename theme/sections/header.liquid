{%- liquid
  assign menu = section.settings.menu
-%}
<div class="header-wrap" data-header>
  <header class="page-width header">
    <details class="menu-drawer" data-dismissable>
      <summary class="icon-btn" aria-label="{{ 'sections.header.menu' | t }}">
        {% render 'icon', name: 'menu', size: 22 %}{% render 'icon', name: 'close', size: 22 %}
      </summary>
      <nav class="menu-drawer__panel" aria-label="{{ 'sections.header.menu' | t }}">
        {%- for link in menu.links -%}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }} {% render 'icon', name: 'arrow-right' %}</a>
          {%- if link.links != blank -%}
            <div class="menu-drawer__sub">
              {%- for child in link.links -%}<a href="{{ child.url }}">{{ child.title }}</a>{%- endfor -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="btn btn--primary btn--lg">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      </nav>
    </details>

    <a href="{{ routes.root_url }}" class="header__logo">
      {% render 'logo' %}
      <span class="visually-hidden">{{ 'general.home' | t }}</span>
    </a>

    <nav class="header__nav" aria-label="{{ 'sections.header.menu' | t }}">
      <ul role="list">
        {%- for link in menu.links -%}
          <li>
            {%- if link.links != blank -%}
              <details data-dismissable>
                <summary class="header__link">{{ link.title }} {% render 'icon', name: 'chevron-down', size: 14 %}</summary>
                <div class="header__dropdown">
                  {%- for child in link.links -%}<a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a>{%- endfor -%}
                </div>
              </details>
            {%- else -%}
              <a href="{{ link.url }}" class="header__link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__actions">
      {%- if settings.show_mode_toggle -%}
        <button type="button" class="icon-btn mode-toggle" data-mode-toggle aria-pressed="false" aria-label="{{ 'sections.header.mode_toggle' | t }}">
          {% render 'icon', name: 'moon' %}{% render 'icon', name: 'sun' %}
        </button>
      {%- endif -%}
      {%- if section.settings.show_search -%}
        <a href="{{ routes.search_url }}" class="icon-btn" data-search-open aria-label="{{ 'sections.header.search' | t }}">{% render 'icon', name: 'search' %}</a>
      {%- endif -%}
      {%- if shop.customer_accounts_enabled and section.settings.show_account -%}
        <a href="{{ routes.account_url }}" class="icon-btn" aria-label="{{ 'sections.header.account' | t }}">{% render 'icon', name: 'account' %}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="icon-btn" data-cart-open aria-label="{{ 'sections.header.cart' | t: count: cart.item_count }}">
        {% render 'icon', name: 'cart' %}
        <span class="cart-count" data-cart-count data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
      </a>
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="btn btn--primary btn--sm header__cta">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
  </header>
</div>

{%- if section.settings.show_search -%}
  <div class="search-modal" data-search-modal hidden>
    <div class="search-modal__box" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.search' | t }}">
      <form action="{{ routes.search_url }}" method="get" role="search" class="inline-form">
        <label for="HeaderSearch" class="visually-hidden">{{ 'sections.header.search' | t }}</label>
        <input id="HeaderSearch" class="input" type="search" name="q" placeholder="{{ 'sections.header.search_placeholder' | t }}" autocomplete="off">
        <button type="submit" class="btn btn--primary">{% render 'icon', name: 'search', size: 18 %}<span class="visually-hidden">{{ 'sections.header.search' | t }}</span></button>
        <button type="button" class="icon-btn" data-search-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
      </form>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "En-tête",
  "class": "section-header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "cta_label", "label": "Bouton d'action", "default": "Essai gratuit" },
    { "type": "url", "id": "cta_link", "label": "Lien du bouton" },
    { "type": "checkbox", "id": "show_search", "label": "Afficher la recherche", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Afficher le compte client", "default": true }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
