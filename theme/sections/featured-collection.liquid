<section class="section" aria-labelledby="Fc-{{ section.id }}">
  <div class="page-width">
    {%- assign hid = 'Fc-' | append: section.id -%}
    {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, lead: section.settings.lead, id: hid %}
    <ul class="product-grid product-grid--4" role="list">
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: section.settings.limit -%}
          <li data-reveal style="--d: {{ forloop.index0 | modulo: 4 | times: 70 }}ms">{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li>{% render 'product-card', product: blank, index: i %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
    {%- if section.settings.collection != blank and section.settings.show_link -%}
      <p class="center" style="margin-top: 2.5rem;"><a href="{{ section.settings.collection.url }}" class="btn btn--secondary">{{ 'sections.featured_collection.view_all' | t }} {% render 'icon', name: 'arrow-right', size: 18 %}</a></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection en vedette",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Boutique" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Nos best-sellers" },
    { "type": "textarea", "id": "lead", "label": "Introduction" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "Nombre de produits", "default": 4 },
    { "type": "checkbox", "id": "show_link", "label": "Lien « Tout voir »", "default": true }
  ],
  "presets": [{ "name": "Collection en vedette" }]
}
{% endschema %}
