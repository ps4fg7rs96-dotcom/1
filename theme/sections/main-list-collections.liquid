{%- comment -%} PAGE « TOUTES LES COLLECTIONS » (/collections). {%- endcomment -%}
{{ 'sections.css' | asset_url | stylesheet_tag }}
<section class="section scheme-{{ section.settings.color_scheme }} pad-{{ section.settings.padding }}">
  <div class="page-width">
    {% render 'section-head', heading: section.settings.heading, h1: true %}
    <ul class="clist clist--{{ section.settings.shape }} clist--grid" style="--cols: {{ section.settings.columns }}" role="list">
      {%- for c in collections -%}
        {%- if c.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
        <li class="clist__item">
          <a href="{{ c.url }}" class="clist__link">
            <span class="clist__media">{%- if c.featured_image -%}{{ c.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '200, 350, 500, 700', sizes: '(min-width: 990px) 25vw, 45vw', alt: '' }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}</span>
            <span class="clist__title">{{ c.title }}</span>
            <span class="small muted">{{ 'collections.count' | t: count: c.products_count }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Liste des collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Toutes les collections" },
    { "type": "select", "id": "shape", "label": "Forme des images", "options": [{ "value": "circle", "label": "Rondes" }, { "value": "square", "label": "Carrées" }, { "value": "portrait", "label": "Portrait" }], "default": "square" },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Colonnes (ordinateur)", "default": 4 },
    {"type": "header", "content": "Mise en forme de la section"},
    {"type": "select", "id": "color_scheme", "label": "Palette de couleurs", "options": [{"value": "theme", "label": "Thème"}, {"value": "alt", "label": "Alternée"}, {"value": "tint", "label": "Teintée"}, {"value": "dark", "label": "Sombre"}, {"value": "primary", "label": "Couleur primaire"}, {"value": "accent", "label": "Couleur d'accent"}, {"value": "custom-1", "label": "Personnalisée 1"}, {"value": "custom-2", "label": "Personnalisée 2"}], "default": "theme"},
    {"type": "select", "id": "padding", "label": "Espacement vertical", "options": [{"value": "none", "label": "Aucun"}, {"value": "s", "label": "Petit"}, {"value": "m", "label": "Moyen"}, {"value": "l", "label": "Grand"}, {"value": "xl", "label": "Très grand"}], "default": "l"}
  ]
}
{% endschema %}
