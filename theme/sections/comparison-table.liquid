{%- comment -%} TABLEAU COMPARATIF — votre produit face aux alternatives (✓ / ✗ / texte), défilable sur mobile. {%- endcomment -%}
{{ 'sections.css' | asset_url | stylesheet_tag }}
<section class="section scheme-{{ section.settings.color_scheme }} pad-{{ section.settings.padding }}">
  <div class="page-width page-width--narrow">
    {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, lead: section.settings.lead %}
    <div class="ctable-wrap">
      <table class="ctable">
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">{{ 'sections.comparison_table.feature' | t }}</span></th>
            <th scope="col" class="ctable__us">{{ section.settings.col_1 }}</th>
            {%- if section.settings.col_2 != blank -%}<th scope="col">{{ section.settings.col_2 }}</th>{%- endif -%}
            {%- if section.settings.col_3 != blank -%}<th scope="col">{{ section.settings.col_3 }}</th>{%- endif -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.feature }}</th>
              {%- for i in (1..3) -%}
                {%- liquid
                  assign col_key = 'col_' | append: i
                  assign v_key = 'v' | append: i
                  if section.settings[col_key] == blank
                    continue
                  endif
                  assign vv = block.settings[v_key] | strip
                  assign vl = vv | downcase
                -%}
                <td{% if i == 1 %} class="ctable__us"{% endif %}>
                  {%- if vl == 'oui' or vl == 'yes' or vl == '✓' -%}<span class="ctable__yes">{% render 'icon', name: 'check', size: 18 %}<span class="visually-hidden">{{ 'general.yes' | t }}</span></span>
                  {%- elsif vl == 'non' or vl == 'no' or vl == '✗' -%}<span class="ctable__no">{% render 'icon', name: 'close', size: 16 %}<span class="visually-hidden">{{ 'general.no' | t }}</span></span>
                  {%- else -%}{{ vv }}{%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tableau comparatif",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Pourquoi nous plutôt qu'ailleurs" },
    { "type": "richtext", "id": "lead", "label": "Introduction" },
    { "type": "text", "id": "col_1", "label": "Colonne 1 (vous)", "default": "Notre produit" },
    { "type": "text", "id": "col_2", "label": "Colonne 2", "default": "Les autres" },
    { "type": "text", "id": "col_3", "label": "Colonne 3" },
    {"type": "header", "content": "Mise en forme de la section"},
    {"type": "select", "id": "color_scheme", "label": "Palette de couleurs", "options": [{"value": "theme", "label": "Thème"}, {"value": "alt", "label": "Alternée"}, {"value": "tint", "label": "Teintée"}, {"value": "dark", "label": "Sombre"}, {"value": "primary", "label": "Couleur primaire"}, {"value": "accent", "label": "Couleur d'accent"}, {"value": "custom-1", "label": "Personnalisée 1"}, {"value": "custom-2", "label": "Personnalisée 2"}], "default": "theme"},
    {"type": "select", "id": "padding", "label": "Espacement vertical", "options": [{"value": "none", "label": "Aucun"}, {"value": "s", "label": "Petit"}, {"value": "m", "label": "Moyen"}, {"value": "l", "label": "Grand"}, {"value": "xl", "label": "Très grand"}], "default": "l"}
  ],
  "blocks": [{ "type": "row", "name": "Ligne", "settings": [
    { "type": "text", "id": "feature", "label": "Critère", "default": "Ingrédients d'origine naturelle" },
    { "type": "paragraph", "content": "Valeurs : « oui » / « non » affichent ✓ / ✗, sinon le texte saisi." },
    { "type": "text", "id": "v1", "label": "Colonne 1", "default": "oui" },
    { "type": "text", "id": "v2", "label": "Colonne 2", "default": "non" },
    { "type": "text", "id": "v3", "label": "Colonne 3" }
  ] }],
  "presets": [{ "name": "Tableau comparatif", "blocks": [{ "type": "row" }, { "type": "row", "settings": { "feature": "Livraison en 48 h" } }, { "type": "row", "settings": { "feature": "Garantie", "v1": "2 ans", "v2": "6 mois" } }] }]
}
{% endschema %}
