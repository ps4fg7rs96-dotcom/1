{%- comment -%} Bandeau de logos clients défilant. Logos = blocs. Sans image : tuile placeholder « [Logo client] ». {%- endcomment -%}
<section class="section scheme-{{ section.settings.color_scheme }} pad-{{ section.settings.padding }}" style="--marquee-speed: {{ section.settings.speed }}s" aria-labelledby="Marquee-{{ section.id }}">
  <div class="page-width">
    <h2 id="Marquee-{{ section.id }}" class="center muted small" style="font-family: var(--font-body); font-weight: 600; letter-spacing: 0; font-size: .9rem;">{{ section.settings.heading }}</h2>
  </div>
  <div class="marquee" style="margin-top: 1.5rem;">
    <div class="marquee__track">
      {%- for pass in (1..2) -%}
        <ul class="marquee__group" role="list"{% if pass == 2 %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            <li class="marquee__item{% if block.settings.logo != blank %} marquee__item--img{% endif %}" {% if pass == 1 %}{{ block.shopify_attributes }}{% endif %}>
              {%- if block.settings.logo != blank -%}
                {{ block.settings.logo | image_url: height: 80 | image_tag: height: 40, loading: 'lazy', alt: block.settings.name }}
              {%- else -%}
                {% render 'icon', name: 'sparkle', size: 16 %}<span class="ph">{{ block.settings.name }}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bandeau logos",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ils accélèrent déjà leur boutique avec Kinetic" },
    { "type": "range", "id": "speed", "min": 15, "max": 80, "step": 5, "unit": "s", "label": "Durée d'un tour", "default": 40 },
    {"type": "header", "content": "Mise en forme de la section"},
    {"type": "select", "id": "color_scheme", "label": "Palette de couleurs", "options": [{"value": "theme", "label": "Thème"}, {"value": "alt", "label": "Alternée"}, {"value": "tint", "label": "Teintée"}, {"value": "dark", "label": "Sombre"}, {"value": "primary", "label": "Couleur primaire"}, {"value": "accent", "label": "Couleur d'accent"}, {"value": "custom-1", "label": "Personnalisée 1"}, {"value": "custom-2", "label": "Personnalisée 2"}], "default": "theme"},
    {"type": "select", "id": "padding", "label": "Espacement vertical", "options": [{"value": "none", "label": "Aucun"}, {"value": "s", "label": "Petit"}, {"value": "m", "label": "Moyen"}, {"value": "l", "label": "Grand"}, {"value": "xl", "label": "Très grand"}], "default": "m"}
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo (SVG ou PNG transparent)" },
        { "type": "text", "id": "name", "label": "Nom (texte alternatif)", "default": "[Logo client]" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bandeau logos",
      "blocks": [
        { "type": "logo", "settings": { "name": "[Logo client 1]" } },
        { "type": "logo", "settings": { "name": "[Logo client 2]" } },
        { "type": "logo", "settings": { "name": "[Logo client 3]" } },
        { "type": "logo", "settings": { "name": "[Logo client 4]" } },
        { "type": "logo", "settings": { "name": "[Logo client 5]" } },
        { "type": "logo", "settings": { "name": "[Logo client 6]" } }
      ]
    }
  ]
}
{% endschema %}
