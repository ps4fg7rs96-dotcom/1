<div class="password">
  <div class="password__box">
    {% render 'logo', tagline: true %}
    <h1 class="h2">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="lead">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'stack' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{{ 'password.subscribed' | t }}</p>
      {%- else -%}
        <div class="inline-form">
          <label for="PasswordNewsletter" class="visually-hidden">{{ 'sections.footer.email' | t }}</label>
          <input id="PasswordNewsletter" class="input" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'sections.footer.email' | t }}">
          <button type="submit" class="btn btn--primary">{{ 'password.notify' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
    <details>
      <summary>{{ 'password.enter_with_password' | t }}</summary>
      {%- form 'storefront_password', class: 'stack' -%}
        {%- if form.errors -%}<p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="inline-form" style="margin-top: 1rem;">
          <label for="StorePassword" class="visually-hidden">{{ 'password.password' | t }}</label>
          <input id="StorePassword" class="input" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
          <button type="submit" class="btn btn--secondary">{{ 'password.enter' | t }}</button>
        </div>
      {%- endform -%}
    </details>
    <p class="small muted">{{ 'password.powered' | t }} {{ powered_by_link }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Page mot de passe",
  "settings": [{ "type": "text", "id": "heading", "label": "Titre", "default": "Ouverture très bientôt" }]
}
{% endschema %}
