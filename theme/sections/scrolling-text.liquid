{%- comment -%} TEXTE DÉFILANT — bandeau de messages en boucle (pause au survol, statique si mouvement réduit). {%- endcomment -%}
{{ 'sections.css' | asset_url | stylesheet_tag }}
<section class="ticker scheme-{{ section.settings.color_scheme }} ticker--{{ section.settings.size }}" style="--ticker-speed: {{ section.settings.speed }}s" aria-label="{{ section.settings.label | escape }}">
  <div class="ticker__track{% if section.settings.reverse %} is-reverse{% endif %}">
    {%- for n in (1..2) -%}
      <ul class="ticker__group" role="list"{% if n == 2 %} aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          <li class="ticker__item" {% if n == 1 %}{{ block.shopify_attributes }}{% endif %}>
            {%- if block.settings.link != blank and n == 1 -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}<span>{{ block.settings.text }}</span>{%- endif -%}
            <span class="ticker__sep" aria-hidden="true">{% if section.settings.separator == 'star' %}✦{% elsif section.settings.separator == 'dot' %}•{% else %}—{% endif %}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Texte défilant",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "label", "label": "Nom accessible", "default": "Annonces" },
    { "type": "select", "id": "size", "label": "Taille", "options": [{ "value": "s", "label": "Petite" }, { "value": "m", "label": "Moyenne" }, { "value": "l", "label": "Grande (titre)" }], "default": "m" },
    { "type": "range", "id": "speed", "min": 10, "max": 80, "step": 5, "unit": "s", "label": "Durée d'un tour", "default": 30 },
    { "type": "checkbox", "id": "reverse", "label": "Sens inverse", "default": false },
    { "type": "select", "id": "separator", "label": "Séparateur", "options": [{ "value": "star", "label": "Étoile" }, { "value": "dot", "label": "Point" }, { "value": "dash", "label": "Tiret" }], "default": "star" },
    { "type": "select", "id": "color_scheme", "label": "Palette de couleurs", "options": [{ "value": "theme", "label": "Thème" }, { "value": "alt", "label": "Alternée" }, { "value": "dark", "label": "Sombre" }, { "value": "primary", "label": "Couleur primaire" }, { "value": "accent", "label": "Couleur d'accent" }, { "value": "custom-1", "label": "Personnalisée 1" }, { "value": "custom-2", "label": "Personnalisée 2" }], "default": "dark" }
  ],
  "blocks": [{ "type": "item", "name": "Message", "settings": [{ "type": "text", "id": "text", "label": "Texte", "default": "Livraison offerte dès 60 €" }, { "type": "url", "id": "link", "label": "Lien" }] }],
  "presets": [{ "name": "Texte défilant", "blocks": [{ "type": "item" }, { "type": "item", "settings": { "text": "Retours gratuits 30 jours" } }, { "type": "item", "settings": { "text": "Paiement en 3 fois" } }] }]
}
{% endschema %}
