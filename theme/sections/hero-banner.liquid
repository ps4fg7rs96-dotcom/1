{%- liquid
  assign heading_tag = 'h2'
  if section.index == 1
    assign heading_tag = 'h1'
  endif
-%}
<section class="banner banner--{{ section.settings.height }} banner--{{ section.settings.position }}" style="--overlay: {{ section.settings.overlay | divided_by: 100.0 }}" aria-labelledby="Banner-{{ section.id }}">
  <div class="banner__media">
    {%- if section.settings.image != blank -%}
      {%- liquid
        assign loading = 'lazy'
        if section.index == 1
          assign loading = 'eager'
        endif
      -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: loading, fetchpriority: 'high', widths: '750, 1100, 1500, 1800, 2400', sizes: '100vw', class: 'banner__img', alt: section.settings.image.alt }}
      {%- if section.settings.image_mobile != blank -%}
        {{ section.settings.image_mobile | image_url: width: 1000 | image_tag: loading: loading, widths: '400, 700, 1000', sizes: '100vw', class: 'banner__img banner__img--mobile', alt: section.settings.image_mobile.alt }}
      {%- endif -%}
    {%- elsif section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'banner__img', image_size: '1600x' }}
    {%- else -%}
      <div class="banner__fallback"></div>
    {%- endif -%}
  </div>
  <div class="page-width banner__content">
    <div class="banner__box{% if section.settings.box %} banner__box--card{% endif %}">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow banner__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <{{ heading_tag }} id="Banner-{{ section.id }}" class="h0">{{ section.settings.heading }}</{{ heading_tag }}>
      {%- if section.settings.text != blank -%}<p class="banner__text">{{ section.settings.text }}</p>{%- endif -%}
      <div class="btn-row">
        {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="btn btn--primary btn--lg">{{ section.settings.cta_label }} {% render 'icon', name: 'arrow-right', size: 18 %}</a>{%- endif -%}
        {%- if section.settings.cta2_label != blank -%}<a href="{{ section.settings.cta2_link | default: routes.all_products_collection_url }}" class="btn btn--ghost-light btn--lg">{{ section.settings.cta2_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bannière",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image mobile (facultatif)"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Ou vidéo de fond (muette, en boucle)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Lancement"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "La nouvelle collection est là"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "default": "Une page de campagne construite avec les blocs du thème, sans page builder."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Bouton principal",
      "default": "Je découvre"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien principal"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Bouton secondaire"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Lien secondaire"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Hauteur",
      "options": [
        {
          "value": "s",
          "label": "Petite"
        },
        {
          "value": "m",
          "label": "Moyenne"
        },
        {
          "value": "l",
          "label": "Grande"
        },
        {
          "value": "full",
          "label": "Plein écran"
        }
      ],
      "default": "l"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position du texte",
      "options": [
        {
          "value": "bottom-left",
          "label": "Bas gauche"
        },
        {
          "value": "center-left",
          "label": "Centre gauche"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "bottom-center",
          "label": "Bas centre"
        }
      ],
      "default": "bottom-left"
    },
    {
      "type": "range",
      "id": "overlay",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Assombrissement de l'image",
      "default": 45
    },
    {
      "type": "checkbox",
      "id": "box",
      "label": "Texte dans un encadré",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Bannière"
    }
  ]
}
{% endschema %}
