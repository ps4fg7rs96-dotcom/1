<section class="banner" aria-labelledby="Banner-{{ section.id }}">
  <div class="banner__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 1800, 2400', sizes: '100vw', alt: section.settings.image.alt }}
    {%- else -%}
      <div class="banner__fallback"></div>
    {%- endif -%}
  </div>
  <div class="page-width banner__content">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" style="color:#f5a084">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 id="Banner-{{ section.id }}" class="h0" style="margin-top:.75rem">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    <div class="btn-row">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="btn btn--primary btn--lg">{{ section.settings.cta_label }} {% render 'icon', name: 'arrow-right', size: 18 %}</a>{%- endif -%}
      {%- if section.settings.cta2_label != blank -%}<a href="{{ section.settings.cta2_link | default: '#' }}" class="btn btn--ghost-light btn--lg">{{ section.settings.cta2_label }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bannière",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Lancement" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "La nouvelle collection est là" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Une page de campagne construite avec les blocs du thème, sans page builder." },
    { "type": "text", "id": "cta_label", "label": "Bouton principal", "default": "Je découvre" },
    { "type": "url", "id": "cta_link", "label": "Lien principal" },
    { "type": "text", "id": "cta2_label", "label": "Bouton secondaire" },
    { "type": "url", "id": "cta2_link", "label": "Lien secondaire" }
  ],
  "presets": [{ "name": "Bannière" }]
}
{% endschema %}
