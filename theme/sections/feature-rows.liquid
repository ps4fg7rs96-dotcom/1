<section class="section scheme-{{ section.settings.color_scheme }} pad-{{ section.settings.padding }}" id="fonctionnalites" aria-labelledby="Features-{{ section.id }}">
  <div class="page-width">
    {%- assign hid = 'Features-' | append: section.id -%}
    {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, lead: section.settings.lead, id: hid %}
    <div class="feature-rows">
      {%- for block in section.blocks -%}
        <article class="feature-row" {{ block.shopify_attributes }}>
          <div class="feature-row__text" data-reveal>
            {%- if block.settings.eyebrow != blank -%}<p class="eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
            <h3>{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<div class="lead">{{ block.settings.text }}</div>{%- endif -%}
            {%- assign bullets = block.settings.bullets | newline_to_br | split: '<br />' -%}
            {%- if block.settings.bullets != blank -%}
              <ul class="check-list" role="list">
                {%- for b in bullets -%}
                  {%- assign line = b | strip -%}
                  {%- if line != blank -%}
                    <li><span class="check-dot">{% render 'icon', name: 'check' %}</span>{{ line }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_link | default: '#' }}" class="btn btn--secondary" style="margin-top: 2rem;">{{ block.settings.button_label }} {% render 'icon', name: 'arrow-right', size: 18 %}</a>
            {%- endif -%}
          </div>
          <div class="feature-row__visual" data-reveal style="--d: 120ms">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 990px) 50vw, 100vw' }}
            {%- else -%}
              {% render 'mockup', type: block.settings.visual %}
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fonctionnalités alternées",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Fonctionnalités" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Un thème, quatre leviers de croissance" },
    { "type": "textarea", "id": "lead", "label": "Introduction" },
    {"type": "header", "content": "Mise en forme de la section"},
    {"type": "select", "id": "color_scheme", "label": "Palette de couleurs", "options": [{"value": "theme", "label": "Thème"}, {"value": "alt", "label": "Alternée"}, {"value": "tint", "label": "Teintée"}, {"value": "dark", "label": "Sombre"}, {"value": "primary", "label": "Couleur primaire"}, {"value": "accent", "label": "Couleur d'accent"}, {"value": "custom-1", "label": "Personnalisée 1"}, {"value": "custom-2", "label": "Personnalisée 2"}], "default": "alt"},
    {"type": "select", "id": "padding", "label": "Espacement vertical", "options": [{"value": "none", "label": "Aucun"}, {"value": "s", "label": "Petit"}, {"value": "m", "label": "Moyen"}, {"value": "l", "label": "Grand"}, {"value": "xl", "label": "Très grand"}], "default": "l"}
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Rangée",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Fonctionnalité" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Un titre orienté bénéfice" },
        { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Décrivez la fonctionnalité et ce qu'elle change pour la boutique.</p>" },
        { "type": "textarea", "id": "bullets", "label": "Points clés (un par ligne)", "default": "Premier point\nDeuxième point\nTroisième point" },
        {
          "type": "select",
          "id": "visual",
          "label": "Visuel intégré",
          "options": [
            { "value": "editor", "label": "Éditeur de blocs" },
            { "value": "cart", "label": "Panier avec upsell" },
            { "value": "templates", "label": "Bibliothèque de modèles" },
            { "value": "landing", "label": "Landing page" }
          ],
          "default": "editor"
        },
        { "type": "image_picker", "id": "image", "label": "Image (remplace le visuel intégré)" },
        { "type": "text", "id": "button_label", "label": "Bouton" },
        { "type": "url", "id": "button_link", "label": "Lien du bouton" }
      ]
    }
  ],
  "presets": [{ "name": "Fonctionnalités alternées", "blocks": [{ "type": "row" }, { "type": "row", "settings": { "visual": "cart" } }] }]
}
{% endschema %}
