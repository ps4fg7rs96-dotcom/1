{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign featured = current_variant.featured_media | default: product.featured_media
-%}
<section class="section section--tight" data-product>
  <div class="page-width product">
    {%- comment -%} Galerie {%- endcomment -%}
    <div class="product__gallery">
      <div class="product__main-media">
        {%- for media in product.media -%}
          <div class="product__media-item{% if media.id == featured.id %} is-active{% endif %}" data-media-id="{{ media.id }}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- if forloop.first -%}
                  {{ media | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '400, 600, 800, 1000, 1200, 1600', sizes: '(min-width: 990px) 55vw, 100vw', alt: media.alt | default: product.title }}
                {%- else -%}
                  {{ media | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200, 1600', sizes: '(min-width: 990px) 55vw, 100vw', alt: media.alt | default: product.title }}
                {%- endif -%}
              {%- when 'video' -%}
                {{ media | video_tag: controls: true, image_size: '1200x' }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag }}
              {%- else -%}
                {{ media | media_tag }}
            {%- endcase -%}
          </div>
        {%- else -%}
          <div class="product__media-item is-active">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        {%- endfor -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="product__thumbs" role="list" aria-label="{{ 'products.product.gallery' | t }}">
          {%- for media in product.media -%}
            <button type="button" class="product__thumb" role="listitem" data-thumb="{{ media.id }}" aria-current="{% if media.id == featured.id %}true{% else %}false{% endif %}" aria-label="{{ 'products.product.show_media' | t: n: forloop.index }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', width: 72, height: 72, alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Infos produit (blocs) {%- endcomment -%}
    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'vendor' -%}
            <p class="eyebrow" {{ block.shopify_attributes }}>{{ product.vendor }}</p>
          {%- when 'title' -%}
            <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>
          {%- when 'rating' -%}
            {%- if product.metafields.reviews.rating.value != blank -%}
              <a href="#reviews" {{ block.shopify_attributes }}>{% render 'stars', rating: product.metafields.reviews.rating.value.rating, count: product.metafields.reviews.rating_count %}</a>
            {%- endif -%}
          {%- when 'price' -%}
            <div class="product__price" data-price-target {{ block.shopify_attributes }}>{% render 'price', product: product, variant: current_variant %}</div>
          {%- when 'tags' -%}
            {%- if product.tags.size > 0 -%}
              <ul class="product__tags" role="list" {{ block.shopify_attributes }}>
                {%- for tag in product.tags limit: block.settings.limit -%}<li class="tag-chip">{{ tag }}</li>{%- endfor -%}
              </ul>
            {%- endif -%}
          {%- when 'text' -%}
            <div class="rte muted" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'inventory' -%}
            {%- if current_variant.inventory_management == 'shopify' and current_variant.available -%}
              {%- if current_variant.inventory_quantity <= block.settings.threshold and current_variant.inventory_quantity > 0 -%}
                <p class="product__inventory product__inventory--low" {{ block.shopify_attributes }}>{{ 'products.product.low_stock' | t: count: current_variant.inventory_quantity }}</p>
              {%- else -%}
                <p class="product__inventory" {{ block.shopify_attributes }}>{{ 'products.product.in_stock' | t }}</p>
              {%- endif -%}
            {%- endif -%}
          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="product__variants" {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  <fieldset class="variant-group" data-option="{{ forloop.index0 }}">
                    <legend>{{ option.name }} : <span class="muted">{{ option.selected_value }}</span></legend>
                    <div class="variant-group__options">
                      {%- for value in option.values -%}
                        <label class="variant-pill">
                          <input type="radio" name="{{ option.name | handle }}-{{ section.id }}" value="{{ value | escape }}" form="{{ form_id }}"{% if option.selected_value == value %} checked{% endif %}>
                          <span>{{ value }}</span>
                        </label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              </div>
            {%- endunless -%}
          {%- when 'buy_buttons' -%}
            <div {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'product__form', data-cart-form: '', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">
                <div class="buy-row">
                  {%- if block.settings.show_quantity -%}
                    <div class="qty">
                      <button type="button" class="qty__btn" data-qty-step="-1" aria-label="{{ 'products.product.decrease' | t }}">{% render 'icon', name: 'minus', size: 16 %}</button>
                      <label for="Qty-{{ section.id }}" class="visually-hidden">{{ 'products.product.quantity' | t }}</label>
                      <input id="Qty-{{ section.id }}" class="qty__input" type="number" name="quantity" value="1" min="1" inputmode="numeric">
                      <button type="button" class="qty__btn" data-qty-step="1" aria-label="{{ 'products.product.increase' | t }}">{% render 'icon', name: 'plus', size: 16 %}</button>
                    </div>
                  {%- endif -%}
                  <button type="submit" name="add" class="btn btn--primary btn--lg" data-add-btn{% unless current_variant.available %} disabled{% endunless %}>
                    <span>{% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
                  </button>
                </div>
                {%- if block.settings.show_dynamic_checkout -%}
                  <div style="margin-top: .75rem">{{ form | payment_button }}</div>
                {%- endif -%}
              {%- endform -%}
            </div>
          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}
          {%- when 'collapsible' -%}
            <div class="accordion" {{ block.shopify_attributes }}>
              <details>
                <summary><h2 class="h4" style="font-family: var(--font-body); font-weight: 600; letter-spacing: 0;">{{ block.settings.heading }}</h2><span class="accordion__icon">{% render 'icon', name: 'plus', size: 18 %}</span></summary>
                <div class="accordion__body rte">
                  {{ block.settings.content }}
                  {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
                </div>
              </details>
            </div>
          {%- when 'trust' -%}
            <ul class="product__trust" role="list" {{ block.shopify_attributes }}>
              {%- if block.settings.line_1 != blank -%}<li>{% render 'icon', name: 'truck', size: 18 %}{{ block.settings.line_1 }}</li>{%- endif -%}
              {%- if block.settings.line_2 != blank -%}<li>{% render 'icon', name: 'refresh', size: 18 %}{{ block.settings.line_2 }}</li>{%- endif -%}
              {%- if block.settings.line_3 != blank -%}<li>{% render 'icon', name: 'shield', size: 18 %}{{ block.settings.line_3 }}</li>{%- endif -%}
            </ul>
          {%- when 'free_shipping' -%}
            <div {{ block.shopify_attributes }}>{% render 'free-shipping-bar' %}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.sticky_atc -%}
    <div class="sticky-atc" data-sticky-atc aria-hidden="true" inert>
      <div class="sticky-atc__info">
        <p class="sticky-atc__title">{{ product.title }}</p>
        <div data-sticky-price>{% render 'price', product: product, variant: current_variant %}</div>
      </div>
      <button type="button" class="btn btn--primary" data-sticky-btn{% unless current_variant.available %} disabled{% endunless %}>
        <span>{% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
      </button>
    </div>
  {%- endif -%}

  <script type="application/json" data-product-json>
    {
      "variants": [
        {%- for v in product.variants limit: 250 -%}
          { "id": {{ v.id }}, "options": {{ v.options | json }}, "available": {{ v.available | json }}, "featured_media_id": {% if v.featured_media %}{{ v.featured_media.id }}{% else %}null{% endif %} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "prices": {
        {%- for v in product.variants limit: 250 -%}
          {%- capture price_html -%}{% render 'price', product: product, variant: v %}{%- endcapture -%}
          "{{ v.id }}": {{ price_html | strip_newlines | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      }
    }
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ request.origin | append: product.url | json }},
      {%- if product.featured_media -%}
        "image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],
      {%- endif -%}
      "description": {{ product.description | strip_html | truncate: 500 | json }},
      {%- if current_variant.sku != blank -%}"sku": {{ current_variant.sku | json }},{%- endif -%}
      "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
      {%- if product.metafields.reviews.rating.value != blank and product.metafields.reviews.rating_count > 0 -%}
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": {{ product.metafields.reviews.rating.value.rating | json }},
          "reviewCount": {{ product.metafields.reviews.rating_count | json }}
        },
      {%- endif -%}
      "offers": [
        {%- for v in product.variants limit: 100 -%}
          {
            "@type": "Offer",
            {%- if v.sku != blank -%}"sku": {{ v.sku | json }},{%- endif -%}
            "availability": "http://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
            "price": {{ v.price | divided_by: 100.0 | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "url": {{ request.origin | append: v.url | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</section>

{% schema %}
{
  "name": "Fiche produit",
  "settings": [
    { "type": "checkbox", "id": "sticky_atc", "label": "Barre d'achat collante sur mobile", "default": true }
  ],
  "blocks": [
    { "type": "vendor", "name": "Marque", "limit": 1 },
    { "type": "title", "name": "Titre", "limit": 1 },
    { "type": "rating", "name": "Note (métachamp reviews)", "limit": 1 },
    { "type": "price", "name": "Prix", "limit": 1 },
    { "type": "tags", "name": "Tags produit", "limit": 1, "settings": [{ "type": "range", "id": "limit", "min": 1, "max": 8, "step": 1, "label": "Nombre max.", "default": 4 }] },
    { "type": "text", "name": "Texte", "settings": [{ "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Un argument clé sur le produit.</p>" }] },
    { "type": "inventory", "name": "État du stock", "limit": 1, "settings": [{ "type": "range", "id": "threshold", "min": 1, "max": 20, "step": 1, "label": "Seuil « stock bas »", "default": 5 }] },
    { "type": "variant_picker", "name": "Sélecteur de variantes", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "Boutons d'achat",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "label": "Sélecteur de quantité", "default": true },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Paiement accéléré (Shop Pay, Apple Pay…)", "default": true }
      ]
    },
    { "type": "free_shipping", "name": "Jauge livraison offerte", "limit": 1 },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "collapsible",
      "name": "Onglet repliable",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Livraison et retours" },
        { "type": "richtext", "id": "content", "label": "Contenu", "default": "<p>Expédition sous 24 h, retours gratuits pendant 30 jours.</p>" },
        { "type": "page", "id": "page", "label": "Contenu d'une page" }
      ]
    },
    {
      "type": "trust",
      "name": "Réassurance",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "line_1", "label": "Ligne 1", "default": "Livraison offerte dès 60 €" },
        { "type": "text", "id": "line_2", "label": "Ligne 2", "default": "Retours gratuits sous 30 jours" },
        { "type": "text", "id": "line_3", "label": "Ligne 3", "default": "Paiement 100 % sécurisé" }
      ]
    }
  ]
}
{% endschema %}
