<section class="section scheme-{{ section.settings.color_scheme }} pad-{{ section.settings.padding }}" id="faq" aria-labelledby="Faq-{{ section.id }}">
  <div class="page-width faq">
    <div class="faq__aside">
      {%- assign hid = 'Faq-' | append: section.id -%}
      {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, lead: section.settings.lead, id: hid, align: 'left' %}
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link | default: routes.root_url }}" class="link">{{ section.settings.link_label }} →</a>
      {%- endif -%}
    </div>
    <div class="accordion" data-reveal>
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary><h3>{{ block.settings.question }}</h3><span class="accordion__icon">{% render 'icon', name: 'plus', size: 18 %}</span></summary>
          <div class="accordion__body rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
  {%- if section.blocks.size > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for block in section.blocks -%}
            { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Vos questions, nos réponses" },
    { "type": "textarea", "id": "lead", "label": "Introduction" },
    { "type": "text", "id": "link_label", "label": "Lien de contact" },
    { "type": "url", "id": "link", "label": "URL du lien" },
    { "type": "checkbox", "id": "open_first", "label": "Ouvrir la première question", "default": false },
    {"type": "header", "content": "Mise en forme de la section"},
    {"type": "select", "id": "color_scheme", "label": "Palette de couleurs", "options": [{"value": "theme", "label": "Thème"}, {"value": "alt", "label": "Alternée"}, {"value": "tint", "label": "Teintée"}, {"value": "dark", "label": "Sombre"}, {"value": "primary", "label": "Couleur primaire"}, {"value": "accent", "label": "Couleur d'accent"}, {"value": "custom-1", "label": "Personnalisée 1"}, {"value": "custom-2", "label": "Personnalisée 2"}], "default": "alt"},
    {"type": "select", "id": "padding", "label": "Espacement vertical", "options": [{"value": "none", "label": "Aucun"}, {"value": "s", "label": "Petit"}, {"value": "m", "label": "Moyen"}, {"value": "l", "label": "Grand"}, {"value": "xl", "label": "Très grand"}], "default": "l"}
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Une question fréquente ?" },
        { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>Une réponse claire et courte.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }] }]
}
{% endschema %}
