{%- comment -%} LOOKBOOK / SHOP THE LOOK — image avec points cliquables liés à des produits + liste des produits. {%- endcomment -%}
{{ 'sections.css' | asset_url | stylesheet_tag }}
<section class="section scheme-{{ section.settings.color_scheme }} pad-{{ section.settings.padding }}">
  <div class="page-width">
    {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, lead: section.settings.lead %}
    <div class="lookbook{% if section.settings.show_list %} lookbook--list{% endif %}">
      <div class="lookbook__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1800', sizes: '(min-width: 990px) 60vw, 100vw', alt: section.settings.image.alt }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          <div class="hotspot" style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%" {{ block.shopify_attributes }}>
            <button type="button" class="hotspot__dot" data-hotspot aria-expanded="false" aria-controls="Hs-{{ block.id }}" aria-label="{{ p.title | default: 'Produit' | escape }}"><span>{{ forloop.index }}</span></button>
            <div class="hotspot__card card" id="Hs-{{ block.id }}">
              {%- if p != blank -%}
                <a href="{{ p.url }}" class="hotspot__img">{%- if p.featured_media -%}{{ p.featured_media | image_url: width: 200 | image_tag: loading: 'lazy', alt: p.title }}{%- endif -%}</a>
                <div><a href="{{ p.url }}" class="hotspot__title">{{ p.title }}</a>{% render 'price', product: p %}
                  <button type="button" class="link small" data-quick-view="{{ p.url }}">{{ 'features.shop_now' | t }}</button></div>
              {%- else -%}
                <p class="small muted">{{ 'sections.lookbook.choose' | t }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
      {%- if section.settings.show_list -%}
        <ol class="lookbook__list" role="list">
          {%- for block in section.blocks -%}
            {%- assign p = block.settings.product -%}
            <li>{%- if p != blank -%}{% render 'product-card', product: p %}{%- else -%}{% render 'product-card', index: forloop.index %}{%- endif -%}</li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lookbook (shop the look)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Shop the look" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Composez l'ensemble" },
    { "type": "richtext", "id": "lead", "label": "Introduction" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "show_list", "label": "Afficher les produits à côté", "default": true },
    {"type": "header", "content": "Mise en forme de la section"},
    {"type": "select", "id": "color_scheme", "label": "Palette de couleurs", "options": [{"value": "theme", "label": "Thème"}, {"value": "alt", "label": "Alternée"}, {"value": "tint", "label": "Teintée"}, {"value": "dark", "label": "Sombre"}, {"value": "primary", "label": "Couleur primaire"}, {"value": "accent", "label": "Couleur d'accent"}, {"value": "custom-1", "label": "Personnalisée 1"}, {"value": "custom-2", "label": "Personnalisée 2"}], "default": "theme"},
    {"type": "select", "id": "padding", "label": "Espacement vertical", "options": [{"value": "none", "label": "Aucun"}, {"value": "s", "label": "Petit"}, {"value": "m", "label": "Moyen"}, {"value": "l", "label": "Grand"}, {"value": "xl", "label": "Très grand"}], "default": "l"}
  ],
  "blocks": [{ "type": "hotspot", "name": "Point produit", "limit": 6, "settings": [
    { "type": "product", "id": "product", "label": "Produit" },
    { "type": "range", "id": "x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Position horizontale", "default": 40 },
    { "type": "range", "id": "y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Position verticale", "default": 40 }
  ] }],
  "presets": [{ "name": "Lookbook (shop the look)", "blocks": [{ "type": "hotspot", "settings": { "x": 35, "y": 30 } }, { "type": "hotspot", "settings": { "x": 62, "y": 58 } }] }]
}
{% endschema %}
