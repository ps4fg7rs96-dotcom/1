{%- comment -%} FRISE CHRONOLOGIQUE — histoire de la marque, étapes de fabrication, suivi d'un processus. {%- endcomment -%}
{{ 'sections.css' | asset_url | stylesheet_tag }}
<section class="section scheme-{{ section.settings.color_scheme }} pad-{{ section.settings.padding }}">
  <div class="page-width page-width--narrow">
    {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, lead: section.settings.lead %}
    <ol class="timeline" role="list">
      {%- for block in section.blocks -%}
        <li class="timeline__item" data-reveal {{ block.shopify_attributes }}>
          <span class="timeline__dot" aria-hidden="true"></span>
          <p class="timeline__date">{{ block.settings.date }}</p>
          <h3 class="h4">{{ block.settings.title }}</h3>
          <div class="rte muted">{{ block.settings.text }}</div>
          {%- if block.settings.image != blank -%}<div class="timeline__img">{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 600, 900', sizes: '(min-width: 750px) 600px, 90vw', alt: block.settings.image.alt }}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Frise chronologique",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Notre histoire" },
    { "type": "richtext", "id": "lead", "label": "Introduction" },
    {"type": "header", "content": "Mise en forme de la section"},
    {"type": "select", "id": "color_scheme", "label": "Palette de couleurs", "options": [{"value": "theme", "label": "Thème"}, {"value": "alt", "label": "Alternée"}, {"value": "tint", "label": "Teintée"}, {"value": "dark", "label": "Sombre"}, {"value": "primary", "label": "Couleur primaire"}, {"value": "accent", "label": "Couleur d'accent"}, {"value": "custom-1", "label": "Personnalisée 1"}, {"value": "custom-2", "label": "Personnalisée 2"}], "default": "theme"},
    {"type": "select", "id": "padding", "label": "Espacement vertical", "options": [{"value": "none", "label": "Aucun"}, {"value": "s", "label": "Petit"}, {"value": "m", "label": "Moyen"}, {"value": "l", "label": "Grand"}, {"value": "xl", "label": "Très grand"}], "default": "l"}
  ],
  "blocks": [{ "type": "step", "name": "Étape", "settings": [
    { "type": "text", "id": "date", "label": "Date / étape", "default": "2020" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Le début de l'aventure" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Racontez ce moment en deux phrases.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ] }],
  "presets": [{ "name": "Frise chronologique", "blocks": [{ "type": "step" }, { "type": "step", "settings": { "date": "2022", "title": "Une étape clé" } }, { "type": "step", "settings": { "date": "Aujourd'hui", "title": "Et demain ?" } }] }]
}
{% endschema %}
