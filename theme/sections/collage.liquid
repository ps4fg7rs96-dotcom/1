{%- comment -%} MOSAÏQUE — images, collections ou produits dans une grille éditoriale (3 dispositions). {%- endcomment -%}
{{ 'sections.css' | asset_url | stylesheet_tag }}
<section class="section scheme-{{ section.settings.color_scheme }} pad-{{ section.settings.padding }}">
  <div class="page-width">
    {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, align: section.settings.head_align %}
    <div class="collage collage--{{ section.settings.layout }}">
      {%- for block in section.blocks limit: 5 -%}
        {%- liquid
          assign url = block.settings.link
          assign img = block.settings.image
          assign title = block.settings.title
          if block.settings.collection != blank
            assign url = url | default: block.settings.collection.url
            assign img = img | default: block.settings.collection.featured_image
            assign title = title | default: block.settings.collection.title
          endif
        -%}
        <a href="{{ url | default: routes.all_products_collection_url }}" class="collage__item collage__item--{{ forloop.index }}" data-reveal {{ block.shopify_attributes }}>
          {%- if img != blank -%}
            {{ img | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 600, 900, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: img.alt | default: title }}
          {%- else -%}
            {%- capture ph -%}{% cycle 'lifestyle-1', 'collection-1', 'collection-2', 'lifestyle-2', 'collection-3' %}{%- endcapture -%}
            {{ ph | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="collage__caption">
            {%- if block.settings.eyebrow != blank -%}<small>{{ block.settings.eyebrow }}</small>{%- endif -%}
            {%- if title != blank -%}<b>{{ title }}</b>{%- endif -%}
            {%- if block.settings.cta != blank -%}<span class="collage__cta">{{ block.settings.cta }} {% render 'icon', name: 'arrow-right', size: 16 %}</span>{%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Mosaïque",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "À découvrir" },
    { "type": "select", "id": "head_align", "label": "Alignement du titre", "options": [{ "value": "center", "label": "Centre" }, { "value": "left", "label": "Gauche" }], "default": "left" },
    { "type": "select", "id": "layout", "label": "Disposition", "options": [{ "value": "a", "label": "1 grande + 2 petites" }, { "value": "b", "label": "2 petites + 1 grande" }, { "value": "c", "label": "1 grande + 4 petites" }, { "value": "d", "label": "3 égales" }], "default": "a" },
    {"type": "header", "content": "Mise en forme de la section"},
    {"type": "select", "id": "color_scheme", "label": "Palette de couleurs", "options": [{"value": "theme", "label": "Thème"}, {"value": "alt", "label": "Alternée"}, {"value": "tint", "label": "Teintée"}, {"value": "dark", "label": "Sombre"}, {"value": "primary", "label": "Couleur primaire"}, {"value": "accent", "label": "Couleur d'accent"}, {"value": "custom-1", "label": "Personnalisée 1"}, {"value": "custom-2", "label": "Personnalisée 2"}], "default": "theme"},
    {"type": "select", "id": "padding", "label": "Espacement vertical", "options": [{"value": "none", "label": "Aucun"}, {"value": "s", "label": "Petit"}, {"value": "m", "label": "Moyen"}, {"value": "l", "label": "Grand"}, {"value": "xl", "label": "Très grand"}], "default": "l"}
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Vignette",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection (remplit image, titre et lien)" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Surtitre" },
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "text", "id": "cta", "label": "Appel à l'action", "default": "Voir" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [{ "name": "Mosaïque", "blocks": [{ "type": "tile", "settings": { "title": "Nouveautés" } }, { "type": "tile", "settings": { "title": "Meilleures ventes" } }, { "type": "tile", "settings": { "title": "Idées cadeaux" } }] }]
}
{% endschema %}
