{%- comment -%} CHIFFRES CLÉS — compteurs animés à l'apparition (valeurs fixes si mouvement réduit). {%- endcomment -%}
{{ 'sections.css' | asset_url | stylesheet_tag }}
<section class="section scheme-{{ section.settings.color_scheme }} pad-{{ section.settings.padding }}">
  <div class="page-width">
    {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
    <ul class="stats" role="list">
      {%- for block in section.blocks -%}
        <li class="stats__item" data-reveal {{ block.shopify_attributes }}>
          <p class="stats__value">{{ block.settings.prefix }}<span data-count-to="{{ block.settings.value }}">{{ block.settings.value }}</span>{{ block.settings.suffix }}</p>
          <p class="stats__label">{{ block.settings.label }}</p>
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.note != blank -%}<p class="small muted center section-foot">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Chiffres clés",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "En quelques chiffres" },
    { "type": "text", "id": "note", "label": "Source / note", "default": "[Chiffres à remplacer par vos données réelles]" },
    {"type": "header", "content": "Mise en forme de la section"},
    {"type": "select", "id": "color_scheme", "label": "Palette de couleurs", "options": [{"value": "theme", "label": "Thème"}, {"value": "alt", "label": "Alternée"}, {"value": "tint", "label": "Teintée"}, {"value": "dark", "label": "Sombre"}, {"value": "primary", "label": "Couleur primaire"}, {"value": "accent", "label": "Couleur d'accent"}, {"value": "custom-1", "label": "Personnalisée 1"}, {"value": "custom-2", "label": "Personnalisée 2"}], "default": "theme"},
    {"type": "select", "id": "padding", "label": "Espacement vertical", "options": [{"value": "none", "label": "Aucun"}, {"value": "s", "label": "Petit"}, {"value": "m", "label": "Moyen"}, {"value": "l", "label": "Grand"}, {"value": "xl", "label": "Très grand"}], "default": "l"}
  ],
  "blocks": [{ "type": "stat", "name": "Chiffre", "limit": 6, "settings": [
    { "type": "text", "id": "prefix", "label": "Avant le nombre" },
    { "type": "text", "id": "value", "label": "Nombre (chiffres uniquement)", "default": "1200" },
    { "type": "text", "id": "suffix", "label": "Après le nombre", "default": "+" },
    { "type": "text", "id": "label", "label": "Libellé", "default": "[Clients satisfaits]" }
  ] }],
  "presets": [{ "name": "Chiffres clés", "blocks": [{ "type": "stat" }, { "type": "stat", "settings": { "value": "48", "suffix": " h", "label": "[Délai d'expédition]" } }, { "type": "stat", "settings": { "value": "4.8", "suffix": "/5", "label": "[Note moyenne]" } }] }]
}
{% endschema %}
