{%- comment -%} DIAPORAMA — images plein écran avec texte, autoplay accessible (pause), points de navigation. {%- endcomment -%}
{{ 'sections.css' | asset_url | stylesheet_tag }}
<section class="slideshow slideshow--{{ section.settings.height }} scheme-{{ section.settings.color_scheme }}" data-slideshow data-autoplay="{% if section.settings.autoplay %}{{ section.settings.speed }}{% else %}0{% endif %}" aria-roledescription="carousel" aria-label="{{ section.settings.label | escape }}">
  <div class="slideshow__track" data-slideshow-track>
    {%- for block in section.blocks -%}
      <div class="slide slide--{{ block.settings.align }}" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ forloop.length }}" style="--overlay: {{ block.settings.overlay | divided_by: 100.0 }}" {{ block.shopify_attributes }}>
        <div class="slide__media">
          {%- if block.settings.image != blank -%}
            {%- if forloop.first -%}
              {{ block.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1600, 2000, 2400', sizes: '100vw', class: 'slide__img', alt: block.settings.image.alt }}
            {%- else -%}
              {{ block.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600, 2000, 2400', sizes: '100vw', class: 'slide__img', alt: block.settings.image.alt }}
            {%- endif -%}
            {%- if block.settings.image_mobile != blank -%}
              {{ block.settings.image_mobile | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '100vw', class: 'slide__img slide__img--mobile', alt: block.settings.image_mobile.alt }}
            {%- endif -%}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg slide__img' }}
          {%- endif -%}
        </div>
        <div class="page-width slide__content">
          <div class="slide__box{% if block.settings.box %} slide__box--card{% endif %}">
            {%- if block.settings.eyebrow != blank -%}<p class="eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
            {%- if block.settings.heading != blank -%}
              {%- if forloop.first and section.index == 1 -%}<h1 class="h0">{{ block.settings.heading }}</h1>{%- else -%}<h2 class="h0">{{ block.settings.heading }}</h2>{%- endif -%}
            {%- endif -%}
            {%- if block.settings.text != blank -%}<div class="lead">{{ block.settings.text }}</div>{%- endif -%}
            <div class="btn-row">
              {%- if block.settings.button_label != blank -%}<a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--primary btn--lg">{{ block.settings.button_label }}</a>{%- endif -%}
              {%- if block.settings.button2_label != blank -%}<a href="{{ block.settings.button2_link | default: routes.all_products_collection_url }}" class="btn btn--secondary btn--lg">{{ block.settings.button2_label }}</a>{%- endif -%}
            </div>
          </div>
        </div>
        {%- if block.settings.link != blank and block.settings.button_label == blank -%}<a class="slide__link" href="{{ block.settings.link }}" aria-label="{{ block.settings.heading | escape }}"></a>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
  {%- if section.blocks.size > 1 -%}
    <div class="slideshow__controls page-width">
      <button type="button" class="slideshow__arrow" data-slide-prev aria-label="{{ 'sections.slideshow.previous' | t }}">{% render 'icon', name: 'chevron-left', size: 18 %}</button>
      <div class="slideshow__dots">
        {%- for block in section.blocks -%}<button type="button" class="slideshow__dot" data-slide-to="{{ forloop.index0 }}" aria-label="{{ 'sections.slideshow.go_to' | t: n: forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>{%- endfor -%}
      </div>
      <button type="button" class="slideshow__arrow" data-slide-next aria-label="{{ 'sections.slideshow.next' | t }}">{% render 'icon', name: 'chevron-right', size: 18 %}</button>
      <button type="button" class="slideshow__arrow" data-slideshow-toggle aria-pressed="false" aria-label="{{ 'sections.slideshow.pause' | t }}" hidden>{% render 'icon', name: 'pause', size: 16 %}</button>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Diaporama",
  "tag": "div",
  "class": "section-slideshow",
  "settings": [
    { "type": "text", "id": "label", "label": "Nom accessible du diaporama", "default": "Mises en avant" },
    { "type": "select", "id": "height", "label": "Hauteur", "options": [{ "value": "s", "label": "Petite" }, { "value": "m", "label": "Moyenne" }, { "value": "l", "label": "Grande" }, { "value": "full", "label": "Plein écran" }], "default": "l" },
    { "type": "checkbox", "id": "autoplay", "label": "Défilement automatique", "default": true },
    { "type": "range", "id": "speed", "min": 3, "max": 10, "step": 1, "unit": "s", "label": "Durée par diapositive", "default": 6 },
    { "type": "select", "id": "color_scheme", "label": "Palette du texte", "options": [{ "value": "theme", "label": "Thème" }, { "value": "dark", "label": "Sombre (texte clair)" }, { "value": "primary", "label": "Couleur primaire" }, { "value": "custom-1", "label": "Personnalisée 1" }, { "value": "custom-2", "label": "Personnalisée 2" }], "default": "dark" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Diapositive",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Image mobile (facultatif)" },
        { "type": "range", "id": "overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Assombrissement de l'image", "default": 30 },
        { "type": "text", "id": "eyebrow", "label": "Surtitre" },
        { "type": "text", "id": "heading", "label": "Titre", "default": "Votre message principal" },
        { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Une phrase qui donne envie d'en voir plus.</p>" },
        { "type": "select", "id": "align", "label": "Position du texte", "options": [{ "value": "left", "label": "Gauche" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Droite" }, { "value": "bottom-left", "label": "Bas gauche" }], "default": "left" },
        { "type": "checkbox", "id": "box", "label": "Texte dans un encadré", "default": false },
        { "type": "text", "id": "button_label", "label": "Bouton 1", "default": "Découvrir" },
        { "type": "url", "id": "button_link", "label": "Lien du bouton 1" },
        { "type": "text", "id": "button2_label", "label": "Bouton 2" },
        { "type": "url", "id": "button2_link", "label": "Lien du bouton 2" },
        { "type": "url", "id": "link", "label": "Lien de toute la diapositive (sans bouton)" }
      ]
    }
  ],
  "presets": [{ "name": "Diaporama", "blocks": [{ "type": "slide" }, { "type": "slide", "settings": { "heading": "Une deuxième bonne raison", "align": "center" } }] }]
}
{% endschema %}
