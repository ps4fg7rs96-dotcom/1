{%- comment -%}
  PAGE COLLECTION — bannière, filtres (barre, colonne latérale ou tiroir ; pastilles de couleur),
  tri, nombre de résultats, choix de colonnes, pagination classique / « Voir plus » / défilement infini,
  vignettes promotionnelles insérées dans la grille (blocs).
{%- endcomment -%}
{{ 'component-collection.css' | asset_url | stylesheet_tag }}
{%- paginate collection.products by section.settings.per_page -%}
  {%- liquid
    assign layout = section.settings.filter_layout
    assign active = 0
    for filter in collection.filters
      assign active = active | plus: filter.active_values.size
    endfor
    assign grid_id = 'CollectionGrid-' | append: section.id
    assign has_filters = false
    if section.settings.enable_filters and collection.filters.size > 0
      assign has_filters = true
    endif
  -%}
  <div class="collection-hero collection-hero--{{ section.settings.banner }}{% if section.settings.banner == 'image' and collection.image %} scheme-dark{% endif %}">
    {%- if section.settings.banner == 'image' and collection.image -%}
      <div class="collection-hero__bg">{{ collection.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 1000, 1500, 2000', sizes: '100vw', alt: '' }}</div>
    {%- endif -%}
    <div class="page-width collection-hero__inner">
      <nav class="breadcrumbs small" aria-label="{{ 'general.breadcrumbs' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a> / <span aria-current="page">{{ collection.title }}</span></nav>
      <h1>{{ collection.title }}</h1>
      {%- if section.settings.show_description and collection.description != blank -%}<div class="rte">{{ collection.description }}</div>{%- endif -%}
    </div>
  </div>

  <section class="page-width collection collection--{{ layout }}{% if has_filters %} has-filters{% endif %}" aria-label="{{ 'collections.products' | t }}">
    <form id="FacetForm-{{ section.id }}" class="collection__form" data-auto-submit>
    </form>

    <div class="toolbar">
      <div class="toolbar__start">
        {%- if has_filters -%}
          <button type="button" class="btn btn--secondary btn--sm filters-toggle" data-dialog-open="Filters-{{ section.id }}" aria-controls="Filters-{{ section.id }}">
            {% render 'icon', name: 'filter', size: 18 %} {{ 'collections.filters' | t }}{% if active > 0 %} ({{ active }}){% endif %}
          </button>
        {%- endif -%}
        <p class="small muted" role="status">{{ 'collections.results' | t: count: collection.products_count }}</p>
      </div>
      <div class="toolbar__end">
        {%- if section.settings.enable_sorting -%}
          <div class="toolbar__sort">
            <label for="SortBy-{{ section.id }}" class="small muted">{{ 'collections.sort_by' | t }}</label>
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            <select id="SortBy-{{ section.id }}" name="sort_by" class="select select--sm" form="FacetForm-{{ section.id }}">
              {%- for option in collection.sort_options -%}<option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>{%- endfor -%}
            </select>
          </div>
        {%- endif -%}
        {%- if section.settings.grid_toggle -%}
          <div class="grid-toggle" role="group" aria-label="{{ 'collections.columns' | t }}">
            <button type="button" class="icon-btn" data-grid-toggle="2" data-target="{{ grid_id }}" aria-pressed="false" aria-label="{{ 'collections.columns_n' | t: n: 2 }}">{% render 'icon', name: 'grid-2', size: 18 %}</button>
            <button type="button" class="icon-btn" data-grid-toggle="{{ section.settings.columns }}" data-target="{{ grid_id }}" aria-pressed="true" aria-label="{{ 'collections.columns_n' | t: n: section.settings.columns }}">{% render 'icon', name: 'grid', size: 18 %}</button>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if active > 0 -%}
      <div class="active-filters">
        {%- for filter in collection.filters -%}
          {%- for v in filter.active_values -%}
            <a href="{{ v.url_to_remove }}">{{ filter.label }} : {{ v.label }} {% render 'icon', name: 'close', size: 14 %}<span class="visually-hidden">{{ 'collections.remove_filter' | t }}</span></a>
          {%- endfor -%}
          {%- if filter.type == 'price_range' -%}
            {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}<a href="{{ filter.url_to_remove }}">{{ filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money }} {% render 'icon', name: 'close', size: 14 %}</a>{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        <a href="{{ collection.url }}?sort_by={{ collection.sort_by }}" class="link">{{ 'collections.clear_all' | t }}</a>
      </div>
    {%- endif -%}

    <div class="collection__body">
      {%- if has_filters -%}
        <dialog id="Filters-{{ section.id }}" class="filters modal" aria-label="{{ 'collections.filters' | t }}">
          <div class="filters__head">
            <p class="h4">{{ 'collections.filters' | t }}</p>
            <button type="button" class="icon-btn" data-dialog-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
          </div>
          <div class="filters__body">
            {%- for filter in collection.filters -%}
              <details class="filter-group"{% if forloop.index <= section.settings.open_filters or filter.active_values.size > 0 %} open{% endif %}>
                <summary>{{ filter.label }}{% if filter.active_values.size > 0 %} <span class="filter-group__count">{{ filter.active_values.size }}</span>{% endif %} {% render 'icon', name: 'chevron-down', size: 16 %}</summary>
                <div class="filter-group__panel">
                  {%- case filter.type -%}
                    {%- when 'price_range' -%}
                      <div class="facet__price">
                        <label class="visually-hidden" for="Min-{{ section.id }}">{{ 'collections.price_min' | t }}</label>
                        <input class="input" type="number" id="Min-{{ section.id }}" form="FacetForm-{{ section.id }}" name="{{ filter.min_value.param_name }}" placeholder="0" value="{{ filter.min_value.value | money_without_currency | replace: ',', '.' }}" min="0" inputmode="decimal">
                        <span aria-hidden="true">–</span>
                        <label class="visually-hidden" for="Max-{{ section.id }}">{{ 'collections.price_max' | t }}</label>
                        <input class="input" type="number" id="Max-{{ section.id }}" form="FacetForm-{{ section.id }}" name="{{ filter.max_value.param_name }}" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '.' }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '.' }}" min="0" inputmode="decimal">
                      </div>
                      <button type="submit" form="FacetForm-{{ section.id }}" class="btn btn--sm btn--primary">{{ 'collections.apply' | t }}</button>
                    {%- when 'boolean' -%}
                      {%- for value in filter.values -%}
                        <label class="filter-check"><input type="checkbox" form="FacetForm-{{ section.id }}" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}> {{ value.label }}</label>
                      {%- endfor -%}
                    {%- else -%}
                      {%- assign is_swatch = false -%}
                      {%- if filter.presentation == 'swatch' or filter.values.first.swatch -%}{%- assign is_swatch = true -%}{%- endif -%}
                      <div class="filter-values{% if is_swatch %} filter-values--swatch{% endif %}">
                        {%- for value in filter.values -%}
                          {%- assign disabled = false -%}
                          {%- if value.count == 0 and value.active == false -%}{%- assign disabled = true -%}{%- endif -%}
                          <label class="filter-check{% if disabled %} is-disabled{% endif %}">
                            <input type="checkbox" form="FacetForm-{{ section.id }}" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if disabled %} disabled{% endif %}>
                            {%- if is_swatch -%}
                              <span class="filter-swatch"{% if value.swatch.image %} style="background-image: url({{ value.swatch.image | image_url: width: 60 }})"{% elsif value.swatch.color %} style="background: {{ value.swatch.color }}"{% endif %}></span>
                            {%- endif -%}
                            <span>{{ value.label }}</span> <span class="muted small">({{ value.count }})</span>
                          </label>
                        {%- endfor -%}
                      </div>
                  {%- endcase -%}
                </div>
              </details>
            {%- endfor -%}
          </div>
          <div class="filters__foot">
            <a href="{{ collection.url }}?sort_by={{ collection.sort_by }}" class="btn btn--secondary">{{ 'collections.clear_all' | t }}</a>
            <button type="button" class="btn btn--primary" data-dialog-close>{{ 'collections.show_results' | t: count: collection.products_count }}</button>
          </div>
          <noscript><button type="submit" form="FacetForm-{{ section.id }}" class="btn btn--primary">{{ 'collections.apply' | t }}</button></noscript>
        </dialog>
      {%- endif -%}

      <div class="collection__products">
        <h2 class="visually-hidden">{{ 'collections.products' | t }}</h2>
        {%- if collection.products.size > 0 -%}
          <ul id="{{ grid_id }}" class="product-grid" style="--cols-desktop: {{ section.settings.columns }}" role="list">
            {%- for product in collection.products -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'promo' and block.settings.position == forloop.parentloop.index and paginate.current_page == 1 -%}
                  <li class="promo-tile promo-tile--{{ block.settings.span }} scheme-{{ block.settings.color_scheme }}" {{ block.shopify_attributes }}>
                    <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="promo-tile__link">
                      {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 700, 1000', sizes: '(min-width: 990px) 50vw, 100vw', class: 'promo-tile__img', alt: '' }}{%- endif -%}
                      <span class="promo-tile__content">
                        {%- if block.settings.eyebrow != blank -%}<span class="eyebrow">{{ block.settings.eyebrow }}</span>{%- endif -%}
                        <span class="h3">{{ block.settings.heading }}</span>
                        {%- if block.settings.button != blank -%}<span class="btn btn--primary btn--sm">{{ block.settings.button }}</span>{%- endif -%}
                      </span>
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
              <li>
                {%- if forloop.index <= 4 -%}{% render 'product-card', product: product, lazy: false %}{%- else -%}{% render 'product-card', product: product %}{%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
          {%- if paginate.pages > 1 -%}
            {%- if section.settings.pagination == 'numbers' -%}
              {% render 'pagination', paginate: paginate %}
            {%- elsif paginate.next -%}
              <div class="load-more" data-load-more-wrap>
                {%- assign shown = paginate.current_offset | plus: collection.products.size -%}
                <p class="small muted">{{ 'collections.shown' | t: shown: shown, total: collection.products_count }}</p>
                <a href="{{ paginate.next.url }}" class="btn btn--secondary" data-load-more="{{ grid_id }}" data-next="{{ paginate.next.url }}" data-infinite="{% if section.settings.pagination == 'infinite' %}true{% else %}false{% endif %}" role="button">{{ 'collections.load_more' | t }}</a>
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- else -%}
          <div class="empty-state">
            <span class="empty-icon">{% render 'icon', name: 'search', size: 28 %}</span>
            <p>{{ 'collections.empty' | t }}</p>
            <a href="{{ collection.url }}" class="link">{{ 'collections.clear_all' | t }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endpaginate -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": {{ collection.title | json }},
    "url": {{ request.origin | append: collection.url | json }},
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ shop.name | json }}, "item": {{ request.origin | append: routes.root_url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ request.origin | append: collection.url | json }} }
      ]
    }
  }
</script>

{% schema %}
{
  "name": "Grille de collection",
  "settings": [
    { "type": "header", "content": "Bannière" },
    { "type": "select", "id": "banner", "label": "Style de bannière", "options": [{ "value": "simple", "label": "Titre simple" }, { "value": "image", "label": "Image de la collection en fond" }], "default": "simple" },
    { "type": "checkbox", "id": "show_description", "label": "Afficher la description", "default": true },
    { "type": "header", "content": "Grille" },
    { "type": "range", "id": "per_page", "min": 8, "max": 48, "step": 4, "label": "Produits par page", "default": 24 },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Colonnes (ordinateur)", "default": 4 },
    { "type": "checkbox", "id": "grid_toggle", "label": "Bouton de choix des colonnes", "default": true },
    { "type": "select", "id": "pagination", "label": "Pagination", "options": [{ "value": "numbers", "label": "Numéros de page" }, { "value": "button", "label": "Bouton « Voir plus »" }, { "value": "infinite", "label": "Défilement infini" }], "default": "button" },
    { "type": "header", "content": "Filtres et tri" },
    { "type": "checkbox", "id": "enable_filters", "label": "Filtres", "info": "Configurez-les dans l'application gratuite Shopify Search & Discovery.", "default": true },
    { "type": "select", "id": "filter_layout", "label": "Disposition des filtres (ordinateur)", "options": [{ "value": "sidebar", "label": "Colonne latérale" }, { "value": "drawer", "label": "Tiroir" }], "default": "sidebar" },
    { "type": "range", "id": "open_filters", "min": 0, "max": 10, "step": 1, "label": "Groupes de filtres ouverts par défaut", "default": 3 },
    { "type": "checkbox", "id": "enable_sorting", "label": "Tri", "default": true }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "promo",
      "name": "Vignette promotionnelle",
      "settings": [
        { "type": "range", "id": "position", "min": 1, "max": 24, "step": 1, "label": "Position dans la grille", "default": 3 },
        { "type": "select", "id": "span", "label": "Taille", "options": [{ "value": "1", "label": "1 case" }, { "value": "2", "label": "2 cases" }], "default": "1" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Offre" },
        { "type": "text", "id": "heading", "label": "Titre", "default": "−20 % sur la 2e pièce" },
        { "type": "text", "id": "button", "label": "Bouton", "default": "J'en profite" },
        { "type": "url", "id": "link", "label": "Lien" },
        { "type": "select", "id": "color_scheme", "label": "Palette", "options": [{ "value": "dark", "label": "Sombre" }, { "value": "primary", "label": "Couleur primaire" }, { "value": "accent", "label": "Couleur d'accent" }, { "value": "tint", "label": "Teintée" }, { "value": "custom-1", "label": "Personnalisée 1" }, { "value": "custom-2", "label": "Personnalisée 2" }], "default": "dark" }
      ]
    }
  ]
}
{% endschema %}
