{%- paginate blog.articles by 9 -%}
  <section class="section">
    <div class="page-width">
      <div class="section-head">
        <p class="eyebrow">{{ 'blogs.label' | t }}</p>
        <h1 class="h1" style="margin-top:.75rem">{{ blog.title }}</h1>
      </div>
      <ul class="grid grid--3" role="list">
        {%- for article in blog.articles -%}
          <li>
            <article class="article-card">
              <a href="{{ article.url }}" class="article-card__media" tabindex="-1" aria-hidden="true">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 33vw, 100vw', alt: '' }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>
              <p class="article-card__meta">{{ article.published_at | time_tag: format: 'date' }}{% if section.settings.show_author %} · {{ article.author }}{% endif %}</p>
              <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
              <p class="muted">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
            </article>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Liste d'articles",
  "settings": [{ "type": "checkbox", "id": "show_author", "label": "Afficher l'auteur", "default": true }]
}
{% endschema %}
