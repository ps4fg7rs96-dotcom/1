{%- assign msgs = section.blocks | where: 'type', 'message' -%}
{%- if msgs.size > 0 -%}
  <div class="announcement" role="region" aria-label="{{ 'sections.announcement.label' | t }}">
    <div class="page-width announcement__inner">
      {%- if section.settings.badge != blank -%}<span class="announcement__badge">{{ section.settings.badge }}</span>{%- endif -%}
      <div class="announcement__slides" data-slides="{{ section.settings.speed | times: 1000 }}">
        {%- for block in msgs -%}
          <p class="announcement__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
            {%- if block.settings.link_label != blank and block.settings.link != blank %}
              <a href="{{ block.settings.link }}">{{ block.settings.link_label }} →</a>
            {%- endif -%}
          </p>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Bandeau annonce",
  "class": "section-announcement",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "Nouveau" },
    { "type": "range", "id": "speed", "min": 3, "max": 10, "step": 1, "unit": "s", "label": "Défilement des messages", "default": 5 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Livraison offerte dès 60 € d'achat" },
        { "type": "text", "id": "link_label", "label": "Texte du lien" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [{ "name": "Bandeau annonce", "blocks": [{ "type": "message" }] }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
