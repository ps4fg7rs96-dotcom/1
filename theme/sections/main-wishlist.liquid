{%- comment -%} PAGE LISTE D'ENVIES — produits enregistrés dans le navigateur (assets/features.js). {%- endcomment -%}
{{ 'sections.css' | asset_url | stylesheet_tag }}
<section class="section scheme-{{ section.settings.color_scheme }} pad-{{ section.settings.padding }}">
  <div class="page-width">
    {% render 'section-head', heading: section.settings.heading, lead: section.settings.text, h1: true %}
    <ul class="product-grid" role="list" data-wishlist-grid></ul>
    <div class="empty-state" data-wishlist-empty hidden>
      <span class="empty-icon">{% render 'icon', name: 'heart', size: 30 %}</span>
      <p class="lead">{{ 'features.wishlist.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary" style="margin-top: 1.5rem;">{{ 'cart.continue' | t }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Liste d'envies",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ma liste d'envies" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Vos coups de cœur, enregistrés sur cet appareil.</p>" },
    {"type": "header", "content": "Mise en forme de la section"},
    {"type": "select", "id": "color_scheme", "label": "Palette de couleurs", "options": [{"value": "theme", "label": "Thème"}, {"value": "alt", "label": "Alternée"}, {"value": "tint", "label": "Teintée"}, {"value": "dark", "label": "Sombre"}, {"value": "primary", "label": "Couleur primaire"}, {"value": "accent", "label": "Couleur d'accent"}, {"value": "custom-1", "label": "Personnalisée 1"}, {"value": "custom-2", "label": "Personnalisée 2"}], "default": "theme"},
    {"type": "select", "id": "padding", "label": "Espacement vertical", "options": [{"value": "none", "label": "Aucun"}, {"value": "s", "label": "Petit"}, {"value": "m", "label": "Moyen"}, {"value": "l", "label": "Grand"}, {"value": "xl", "label": "Très grand"}], "default": "l"}
  ]
}
{% endschema %}
