{%- comment -%} BANNIÈRE COMPTE À REBOURS — soldes, lancement, Black Friday. Se masque à la fin si souhaité. {%- endcomment -%}
{{ 'sections.css' | asset_url | stylesheet_tag }}
{%- assign cd_end = section.settings.end_date | append: 'T' | append: section.settings.end_time | append: ':00' -%}
<section class="section scheme-{{ section.settings.color_scheme }} pad-{{ section.settings.padding }} cd-banner" data-countdown-wrap>
  {%- if section.settings.image != blank -%}<div class="cd-banner__bg" style="--overlay: {{ section.settings.overlay | divided_by: 100.0 }}">{{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '600, 1000, 1500, 2000', sizes: '100vw', alt: '' }}</div>{%- endif -%}
  <div class="page-width cd-banner__inner">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="lead">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="countdown">
      <div class="countdown__timer countdown__timer--lg" data-countdown="{{ cd_end }}" data-hide-ended="{{ section.settings.hide_ended }}" role="timer" aria-label="{{ section.settings.heading | escape }}">
        <span><b data-cd="d">00</b><small>{{ 'features.countdown.days' | t }}</small></span>
        <span><b data-cd="h">00</b><small>{{ 'features.countdown.hours' | t }}</small></span>
        <span><b data-cd="m">00</b><small>{{ 'features.countdown.minutes' | t }}</small></span>
        <span><b data-cd="s">00</b><small>{{ 'features.countdown.seconds' | t }}</small></span>
      </div>
      <div class="btn-row">
        {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--primary btn--lg">{{ section.settings.button_label }}</a>{%- endif -%}
        {%- if section.settings.code != blank -%}<button type="button" class="discount-code" data-copy="{{ section.settings.code | escape }}">{{ section.settings.code }} <span class="small">{% render 'icon', name: 'copy', size: 16 %} {{ 'features.copy' | t }}</span></button>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bannière compte à rebours",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Offre limitée" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Les soldes se terminent bientôt" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Jusqu'à −30 % sur une sélection.</p>" },
    { "type": "text", "id": "end_date", "label": "Date de fin (AAAA-MM-JJ)", "default": "2026-12-31" },
    { "type": "text", "id": "end_time", "label": "Heure de fin (HH:MM)", "default": "23:59" },
    { "type": "checkbox", "id": "hide_ended", "label": "Masquer la section à la fin", "default": true },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "J'en profite" },
    { "type": "url", "id": "button_link", "label": "Lien" },
    { "type": "text", "id": "code", "label": "Code promo à copier" },
    { "type": "image_picker", "id": "image", "label": "Image de fond" },
    { "type": "range", "id": "overlay", "min": 0, "max": 90, "step": 5, "unit": "%", "label": "Assombrissement", "default": 50 },
    {"type": "header", "content": "Mise en forme de la section"},
    {"type": "select", "id": "color_scheme", "label": "Palette de couleurs", "options": [{"value": "theme", "label": "Thème"}, {"value": "alt", "label": "Alternée"}, {"value": "tint", "label": "Teintée"}, {"value": "dark", "label": "Sombre"}, {"value": "primary", "label": "Couleur primaire"}, {"value": "accent", "label": "Couleur d'accent"}, {"value": "custom-1", "label": "Personnalisée 1"}, {"value": "custom-2", "label": "Personnalisée 2"}], "default": "dark"},
    {"type": "select", "id": "padding", "label": "Espacement vertical", "options": [{"value": "none", "label": "Aucun"}, {"value": "s", "label": "Petit"}, {"value": "m", "label": "Moyen"}, {"value": "l", "label": "Grand"}, {"value": "xl", "label": "Très grand"}], "default": "l"}
  ],
  "presets": [{ "name": "Bannière compte à rebours" }]
}
{% endschema %}
