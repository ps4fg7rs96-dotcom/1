{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_card.title' | t }} – {{ shop.name }}</title>
    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="gift-card-page">
    <main class="page-width page-width--narrow section gift-card">
      <a href="{{ shop.url }}" class="gift-card__logo">{% render 'logo' %}</a>
      <div class="card gift-card__card">
        <p class="eyebrow">{{ 'gift_card.title' | t }}</p>
        <p class="h0 gift-card__amount">{{ gift_card.balance | money }}</p>
        {%- if gift_card.balance != gift_card.initial_value -%}{%- assign initial = gift_card.initial_value | money -%}<p class="muted">{{ 'gift_card.initial' | t: amount: initial }}</p>{%- endif -%}
        {%- if gift_card.expired or gift_card.enabled == false -%}
          <p class="badge badge--muted">{{ 'gift_card.disabled' | t }}</p>
        {%- elsif gift_card.expires_on -%}
          {%- assign exp = gift_card.expires_on | date: '%d/%m/%Y' -%}
          <p class="small muted">{{ 'gift_card.expires' | t: date: exp }}</p>
        {%- endif -%}
        <div class="gift-card__code">
          <code>{{ gift_card.code | format_code }}</code>
          <button type="button" class="btn btn--secondary btn--sm" onclick="navigator.clipboard && navigator.clipboard.writeText('{{ gift_card.code }}'); this.textContent='{{ 'features.copied' | t }}'">{{ 'features.copy' | t }}</button>
        </div>
        <div id="QrCode" class="gift-card__qr" data-identifier="{{ gift_card.qr_identifier }}"></div>
        <div class="btn-row btn-row--center">
          <a href="{{ shop.url }}" class="btn btn--primary btn--lg">{{ 'gift_card.shop' | t }}</a>
          <button type="button" class="btn btn--secondary btn--lg" onclick="window.print()">{{ 'gift_card.print' | t }}</button>
        </div>
        {%- if gift_card.pass_url -%}<a href="{{ gift_card.pass_url }}" class="link">{{ 'gift_card.wallet' | t }}</a>{%- endif -%}
      </div>
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (el && window.QRCode) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
